@* Governance tab: nine operator/admin panes sharing one sub-view toggle - Providers (credential/model
   management plus per-provider monthly budgets), Price Sources, Price Overrides, Benchmark Data, Routing
   Mode, Cluster Model, Router Model, Regret Harness, and Judge Calibration. Budgets used to be a separate
   sub-view of hardcoded mock pools; they now live on each real provider's card in ProvidersAdmin. See
   docs/gui/dashboard.md §"Governance" for what each pane does. *@
<div class="h-full flex flex-col">
    @* Sub-view toggle *@
    <div class="flex items-center gap-1 mb-3 shrink-0">
        @foreach (var (view, label) in Views)
        {
            var isActive = _view == view;
            <button @onclick="() => _view = view"
                    class="gov-tab @(isActive ? "active" : "inactive")">
                @label
            </button>
        }
    </div>

    @if (_view == GovView.Providers)
    {
        <div class="flex-1 min-h-0">
            <ProvidersAdmin/>
        </div>
    }
    else if (_view == GovView.PriceSources)
    {
        <div class="flex-1 min-h-0">
            <PriceSourcesAdmin/>
        </div>
    }
    else if (_view == GovView.PriceOverrides)
    {
        <div class="flex-1 min-h-0">
            <PriceOverridesAdmin/>
        </div>
    }
    else if (_view == GovView.BenchmarkData)
    {
        <div class="flex-1 min-h-0">
            <BenchmarkData/>
        </div>
    }
    else if (_view == GovView.RoutingMode)
    {
        <div class="flex-1 min-h-0">
            <RoutingModeAdmin/>
        </div>
    }
    else if (_view == GovView.ClusterModel)
    {
        <div class="flex-1 min-h-0">
            <ClusterModelAdmin/>
        </div>
    }
    else if (_view == GovView.RouterModel)
    {
        <div class="flex-1 min-h-0">
            <RouterModelAdmin/>
        </div>
    }
    else if (_view == GovView.RegretHarness)
    {
        <div class="flex-1 min-h-0">
            <RegretHarnessAdmin/>
        </div>
    }
    else
    {
        <div class="flex-1 min-h-0">
            <JudgeCalibrationAdmin/>
        </div>
    }
</div>

@code {

    private enum GovView
    {
        Providers,
        PriceSources,
        PriceOverrides,
        BenchmarkData,
        RoutingMode,
        ClusterModel,
        RouterModel,
        RegretHarness,
        JudgeCalibration
    }

    private static readonly (GovView View, string Label)[] Views =
    [
        (GovView.Providers, "Providers"),
        (GovView.PriceSources, "Price Sources"),
        (GovView.PriceOverrides, "Price Overrides"),
        (GovView.BenchmarkData, "Benchmark Data"),
        (GovView.RoutingMode, "Routing Mode"),
        (GovView.ClusterModel, "Cluster Model"),
        (GovView.RouterModel, "Router Model"),
        (GovView.RegretHarness, "Regret Harness"),
        (GovView.JudgeCalibration, "Judge Calibration")
    ];

    private GovView _view = GovView.Providers;
}