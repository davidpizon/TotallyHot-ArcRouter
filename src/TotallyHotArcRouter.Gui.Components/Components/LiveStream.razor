@using Microsoft.JSInterop
@* Sessions tab: always-on three-pane layout (session rail · messages · details). #176 Phase 1. *@
@inject IJSRuntime Js
@inject SessionsViewState ViewState

@if (Conversations.Count == 0)
{
    <div class="h-full flex flex-col min-h-0 p-4">
        @if (OnExportRequested.HasDelegate)
        {
            <div class="flex justify-end shrink-0 mb-2">
                <button @onclick="OnExportRequested"
                        data-testid="sessions-export"
                        class="shrink-0 flex items-center gap-1.5 rounded px-2.5 py-2 text-xs font-medium border border-slate-700 text-slate-400 hover:border-slate-500 hover:text-slate-200 transition-colors">
                    Export
                </button>
            </div>
        }
        <div class="flex-1 flex items-center justify-center">
            <div class="w-full max-w-xl space-y-3">
                <p class="text-xs text-slate-500 text-center">No conversations yet.</p>
                @if (HistoryNotice is not null)
                {
                    <p class="text-xs text-slate-500 text-center ls-history-notice" role="status">@HistoryNotice</p>
                }
                <ClientDropInPanel/>
            </div>
        </div>
    </div>
    return;
}

<div class="h-full flex flex-col min-h-0">
    @if (HistoryNotice is not null)
    {
        <p class="shrink-0 mb-2 text-xs text-slate-500 ls-history-notice" role="status">@HistoryNotice</p>
    }
    @if (ShowContentGate)
    {
        <ContentGateBar Locked="ContentLocked"
                        ShowEnrollmentHint="ShowEnrollmentHint"
                        EnrollmentCommandHint="@EnrollmentCommandHint"
                        ExpiresAtUtc="ContentExpiresAtUtc"
                        OnUnlock="OnUnlockRequested"
                        OnAddPasskey="OnAddPasskeyRequested"
                        OnLock="OnLockRequested"/>
    }

    <div class="ls-sessions-scroll flex-1 min-h-0">
        <div @ref="_container" class="ls-sessions-layout">
            <div @ref="_railPanel" class="ls-sessions-rail-host min-h-0">
                <SessionRail Conversations="OrderedConversations"
                             SelectedId="@SelectedId"
                             OnSelect="OnSelect"
                             TranscriptCaptureEnabled="TranscriptCaptureEnabled"
                             OnExportRequested="OnExportRequested"/>
            </div>

            <div @ref="_leftDivider" class="ls-divider" title="Drag to resize session rail"></div>

            <div class="ls-chat-host flex flex-col min-h-0 flex-1">
                @if (ActiveConversation is not null)
                {
                    <SessionMessagesPane Conversation="ActiveConversation"
                                         ContentLocked="ShowContentGate && ContentLocked"
                                         OnSelectionChanged="StateHasChanged"/>
                }
            </div>

            <div @ref="_rightDivider" class="ls-divider" title="Drag to resize details pane"></div>

            <div @ref="_detailsPanel" class="ls-details-host min-h-0">
                <SessionDetailsPane Conversation="ActiveConversation"
                                    Selection="ViewState.MessageSelection"/>
            </div>
        </div>
    </div>
</div>

@code {

    /// <summary>All conversations shown in the session rail (live + persisted, already merged by the host).</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Conversation> Conversations { get; set; } = [];

    /// <summary>
    /// Dashboard's shared selection id. When empty or stale, the rail implicitly shows the most recently
    /// active session without calling <see cref="OnSelect"/>.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string SelectedId { get; set; } = string.Empty;

    /// <summary>Invoked only on explicit rail selection (click or keyboard), never on implicit fallback.</summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>
    /// Invoked with the id of the session shown by implicit selection (no explicit or still-present
    /// <see cref="SelectedId"/>) whenever that session changes, so the host can load its persisted text.
    /// Unlike <see cref="OnSelect"/> it does not change Dashboard's shared selection.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnImplicitSessionShown { get; set; }

    /// <summary>
    /// Whether the router has transcript capture enabled. Shown in the rail footer; Phase 2 also gates
    /// persisted detail sections on this.
    /// </summary>
    [Parameter]
    public bool TranscriptCaptureEnabled { get; set; }

    /// <summary>
    /// A one-line notice about persisted history — a failed load, or that only the newest turns are shown —
    /// or <see langword="null"/> for none. See <see cref="PersistedSessionStore.HistoryNotice"/>.
    /// </summary>
    [Parameter]
    public string? HistoryNotice { get; set; }

    /// <summary>
    /// Whether this host has the passkey content gate (ADR-0020) and so shows the lock/unlock strip.
    /// </summary>
    [Parameter]
    public bool ShowContentGate { get; set; }

    /// <summary>Whether conversation text is currently locked. Only read when <see cref="ShowContentGate"/> is set.</summary>
    [Parameter]
    public bool ContentLocked { get; set; }

    /// <summary>
    /// Whether the router has confirmed that no passkey is enrolled, so the strip names the enrollment command.
    /// </summary>
    [Parameter]
    public bool ShowEnrollmentHint { get; set; }

    /// <summary>The elevated-shell command that mints an enrollment code.</summary>
    [Parameter]
    public string EnrollmentCommandHint { get; set; } = PasskeyOperations.EnrollmentCommandFlag;

    /// <summary>When the active unlock lapses; <see langword="null"/> shows no time.</summary>
    [Parameter]
    public DateTimeOffset? ContentExpiresAtUtc { get; set; }

    /// <summary>Invoked when the operator asks to unlock conversation text with a passkey.</summary>
    [Parameter]
    public EventCallback OnUnlockRequested { get; set; }

    /// <summary>Invoked when the operator asks to add the first passkey from the locked strip.</summary>
    [Parameter]
    public EventCallback OnAddPasskeyRequested { get; set; }

    /// <summary>Invoked when the operator asks to lock conversation text again.</summary>
    [Parameter]
    public EventCallback OnLockRequested { get; set; }

    /// <summary>
    /// Invoked when the operator asks to export conversations. The Export button is shown only when a host
    /// supplies this callback.
    /// </summary>
    [Parameter]
    public EventCallback OnExportRequested { get; set; }

    private ElementReference _container;
    private ElementReference _railPanel;
    private ElementReference _detailsPanel;
    private ElementReference _leftDivider;
    private ElementReference _rightDivider;

    private IReadOnlyList<Conversation> _orderedConversations = [];
    private Conversation? _activeConversation;

    /// <summary>
    /// Conversations sorted most recently active first for the rail. Sorted once per parameter change in
    /// <see cref="OnParametersSet"/> because the markup, the implicit-selection check and the active-session
    /// lookup all read it during one render.
    /// </summary>
    private IReadOnlyList<Conversation> OrderedConversations => _orderedConversations;

    /// <summary>
    /// The conversation shown in the middle and right panes: explicit <see cref="SelectedId"/> when still
    /// present, otherwise the most recently active session (implicit; does not call <see cref="OnSelect"/>).
    /// </summary>
    private Conversation? ActiveConversation => _activeConversation;

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        _orderedConversations = [.. Conversations.OrderByDescending(NewestTurnUtc)];
        _activeConversation = string.IsNullOrEmpty(SelectedId)
            ? null
            : Conversations.FirstOrDefault(c => c.Id == SelectedId);
        _activeConversation ??= _orderedConversations.FirstOrDefault();
    }

    private string? _lastImplicitShownId;

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        // The rail falls back to the newest session without calling OnSelect, so a persisted-only session
        // shown that way would otherwise never have its stored text loaded and read as "No request captured".
        var implicitId = !string.IsNullOrEmpty(SelectedId) && ActiveConversation?.Id == SelectedId
            ? null
            : ActiveConversation?.Id;
        if (implicitId is null || implicitId == _lastImplicitShownId) return;
        _lastImplicitShownId = implicitId;
        await OnImplicitSessionShown.InvokeAsync(implicitId);
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Conversations.Count == 0) return;
        try
        {
            await Js.InvokeVoidAsync("splitPane.init", _container, _leftDivider, _railPanel,
                new { edge = "left", minPct = 15, maxPct = 35, defaultPct = 22,
                    storageKey = "arcrouter.sessions.leftPct", minPx = 220, siblingMinPx = 280, middleMinPx = 360, dividersPx = 24 });
            await Js.InvokeVoidAsync("splitPane.init", _container, _rightDivider, _detailsPanel,
                new { edge = "right", minPct = 20, maxPct = 40, defaultPct = 28,
                    storageKey = "arcrouter.sessions.rightPct", minPx = 280, siblingMinPx = 220, middleMinPx = 360, dividersPx = 24 });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { /* Loose mode / missing script in tests */ }
    }

    private static DateTimeOffset NewestTurnUtc(Conversation c) =>
        c.Turns.Count == 0 ? DateTimeOffset.MinValue : c.Turns.Max(t => t.TimestampUtc);

}
