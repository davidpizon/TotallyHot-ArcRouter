@* Routing tab of the Sessions details pane (#176 §7): decision, overhead, and step log. *@
<div class="space-y-3">
    <div class="text-xs text-slate-400">Routing · Turn @Turn.TurnNumber · @TurnCount loaded</div>

    <section>
        <div class="ls-stat-label mb-1">Decision</div>
        <div class="ls-kv-grid">
            <span>Requested → routed</span>
            <span>@(Turn.RequestedModel ?? "—") → @(Turn.RoutedModel ?? Turn.Model)</span>
            <span>Substitution</span><span>@(VisibleSubstitution ?? "—")</span>
            <span>Fallback</span>
            <span>@FallbackDisplay</span>
        </div>
    </section>

    <section>
        <div class="ls-stat-label mb-1">Router overhead</div>
        <div class="ls-kv-grid">
            <span>Router tokens</span>
            <span class="font-mono">@LiveOnly(Turn.RouterTokens?.ToString(CultureInfo.InvariantCulture), "Persisted history does not record router overhead")</span>
            <span>Router cost</span>
            <span class="font-mono">@LiveOnly(Turn.RouterCostUsd is null ? null : $"${Turn.RouterCostUsd.Value.ToString("F6", CultureInfo.InvariantCulture)}", "Persisted history does not record router overhead")</span>
        </div>
    </section>

    <section>
        <div class="ls-stat-label mb-1">Steps</div>
        @if (Turn.RoutingSteps.Count == 0)
        {
            <p class="text-xs text-slate-500">No routing steps recorded.</p>
        }
        else
        {
            <ul class="space-y-1">
                @foreach (var step in Turn.RoutingSteps)
                {
                    <li class="text-xs rounded px-2 py-1 @StepClass(step.Status)">@step.Message</li>
                }
            </ul>
        }
    </section>
</div>

@code {

    /// <summary>The selected turn whose routing decision is shown.</summary>
    [Parameter]
    [EditorRequired]
    public ConversationTurn Turn { get; set; } = null!;

    /// <summary>Total turns in the loaded conversation.</summary>
    [Parameter]
    public int TurnCount { get; set; }

    private string? VisibleSubstitution =>
        string.IsNullOrEmpty(Turn.SubstitutionReason)
        || string.Equals(Turn.SubstitutionReason, "None", StringComparison.Ordinal)
        || string.Equals(Turn.SubstitutionReason, "AutoSelect", StringComparison.Ordinal)
            ? null
            : Turn.SubstitutionReason;

    private MarkupString FallbackDisplay =>
        Turn.IsLive
            ? new MarkupString(Turn.IsFallback ? "yes" : "no")
            : new MarkupString(DashHtml("Persisted history does not record fallback"));

    private MarkupString LiveOnly(string? value, string reason) =>
        new(Turn.IsLive && value is not null
            ? System.Net.WebUtility.HtmlEncode(value)
            : DashHtml(reason));

    private static string DashHtml(string reason) =>
        $"<span class=\"text-slate-500\" tabindex=\"0\" aria-describedby=\"ls-tooltip\" data-tip=\"{System.Net.WebUtility.HtmlEncode(reason)}\">—</span>";

    private static string StepClass(StepStatus status) => status switch
    {
        StepStatus.Warn => "ds-step-warning",
        StepStatus.Info => "ds-step-info",
        _ => "ds-step-info"
    };

}
