@* Thin reusable Apache ECharts host. Takes a pre-serialized chart-model JSON (built in
   TotallyHot.ArcRouter.Gui.Charts and serialized with ChartJson) and hands it to wwwroot/js/echarts-interop.js,
   which owns the ECharts option construction and animations. Re-renders whenever the JSON changes, and
   disposes the underlying ECharts instance on teardown so a tab/metric switch never leaks a chart. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<div id="@_elementId" class="w-full h-full"></div>

@code {

    /// <summary>
    /// The serialized CostChartModel / GroupedBarsModel / DonutModel to render. Changing it re-renders.
    /// </summary>
    [Parameter] [EditorRequired] public string ModelJson { get; set; } = string.Empty;

    /// <summary>
    /// Invoked when the user clicks or taps an epoch mark. Hover stays in the chart tooltip.
    /// The argument is the epoch row id. Charts without epoch marks never call it.
    /// </summary>
    [Parameter] public EventCallback<long> EpochClick { get; set; }

    private readonly string _elementId = "echart-" + Guid.NewGuid().ToString("N");
    private string? _rendered;
    private bool _disposed;
    private DotNetObjectReference<EChart>? _dotNet;

    /// <summary>Opens the epoch detail for <paramref name="id"/>. The chart script calls this on click and on tap.</summary>
    /// <param name="id">The epoch row id carried on the mark.</param>
    [JSInvokable]
    public Task OnEpochClick(long id)
    {
        return EpochClick.InvokeAsync(id);
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS interop is only valid after the element exists; re-render only when the model actually
        // changed so unrelated parent re-renders don't rebuild the chart (and interrupt animations).
        if (_disposed || _rendered == ModelJson)
        {
            return;
        }

        _rendered = ModelJson;
        _dotNet ??= DotNetObjectReference.Create(this);
        try
        {
            await Js.InvokeVoidAsync(identifier: "echartsInterop.render", _elementId, ModelJson, _dotNet);
        }
        catch (JSDisconnectedException)
        {
            // WebView tearing down (navigation/app close) - nothing to render into.
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _dotNet?.Dispose();
        _dotNet = null;
        try
        {
            await Js.InvokeVoidAsync(identifier: "echartsInterop.dispose", _elementId);
        }
        catch (JSDisconnectedException)
        {
            // WebView already gone; the instance goes with it.
        }
        catch (ObjectDisposedException)
        {
            // JS runtime disposed ahead of this component.
        }
    }

}