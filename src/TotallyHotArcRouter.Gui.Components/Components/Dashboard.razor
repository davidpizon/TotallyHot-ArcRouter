@* Root dashboard component: header with live status banner, ticker row, tab bar, and the active tab. *@
@implements IDisposable
@inject LiveDataStore LiveDataStore
@inject PersistedSessionStore PersistedSessionStore
@inject ProviderAdminStore ProviderStore
@inject UsageStore UsageStore

<div class="flex flex-col h-screen overflow-hidden ds-surface-base">
    @* ── HEADER ── *@
    <header class="ds-toolbar">
        <div class="flex items-center justify-between px-4 py-2.5">
            @* Brand *@
            <div class="flex items-center gap-2">
                <span class="text-sm font-bold tracking-tight text-slate-100">
                    🤖 Router Optimization Engine
                </span>
            </div>

            @* Status banner *@
            <div class="flex items-center">
                @if (_breached.Count > 0 && _approaching.Count > 0)
                {
                    <button @onclick="HandleAlertClick" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                        <span class="font-semibold text-xs text-red-400">🚨 @_breached.Count BREACHED</span>
                        <span class="text-slate-600">|</span>
                        <span class="font-semibold text-xs text-amber-400">⚠️ @_approaching.Count APPROACHING LIMIT</span>
                    </button>
                }
                else if (_breached.Count > 0)
                {
                    <button @onclick="HandleAlertClick" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                        <span class="font-semibold text-xs text-red-400">🚨 @_breached.Count PROVIDER BREACHED</span>
                    </button>
                }
                else if (_approaching.Count > 0)
                {
                    <button @onclick="HandleAlertClick" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                        <span class="font-semibold text-xs text-amber-400">⚠️ @_approaching.Count PROVIDER APPROACHING LIMIT</span>
                    </button>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <span class="pulse-dot w-1.5 h-1.5 rounded-full indicator-active"></span>
                        <span class="text-xs font-medium text-emerald-400">System Status: OK</span>
                    </div>
                }
            </div>

            @* Actions *@
            <div class="flex items-center gap-2">
                <button @onclick="() => _showSettings = true"
                        class="flex items-center gap-1.5 rounded px-2.5 py-1.5 text-xs font-medium border border-slate-700 text-slate-400 hover:border-slate-500 hover:text-slate-200 transition-colors">
                    <Icon Name="settings" Size="20"/>
                    Settings
                </button>
            </div>
        </div>

        @* Ticker row *@
        <div class="flex items-center gap-6 px-4 py-1.5 ds-dashboard-ticker">
            @* Total Saved and Avg. Cost Reduction stay demo values - they need a worst-case-baseline ROI
               concept the token-tracking plan deliberately does not invent (docs/gui/backlog.md). *@
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500">Total Saved (demo)</span>
                <span class="font-mono text-xs font-semibold text-emerald-400">$142.36</span>
            </div>
            <div class="w-px h-3 ds-divider"></div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500">System Tokens</span>
                <span class="font-mono text-xs font-semibold text-slate-200">@_systemTokensDisplay</span>
            </div>
            <div class="w-px h-3 ds-divider"></div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500">Avg. Cost Reduction (demo)</span>
                <span class="font-mono text-xs font-semibold text-emerald-400">74.20% ↓</span>
            </div>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="pulse-dot w-1.5 h-1.5 rounded-full indicator-active"></span>
                <span class="text-xs font-mono text-slate-600">LIVE</span>
            </div>
        </div>
    </header>

    @* ── TAB BAR ── *@
    <nav class="flex items-end px-4 gap-0 shrink-0 ds-toolbar">
        @foreach (var (tab, icon, label) in Tabs)
        {
            var isActive = _activeTab == tab;
            <button @onclick="() => _activeTab = tab"
                    class="tab-indicator tab-button @(isActive ? "active" : "inactive")">
                <Icon Name="@icon" Size="20"/>
                @label
            </button>
        }
    </nav>

    @* ── WORKSPACE ── *@
    @* @key on the active tab makes Blazor tear down and rebuild this node on every tab change,
       which is what re-fires the panel-enter animation (a transition would have nothing to run
       from). h-full min-h-0 keeps the height chain intact — every tab root is h-full. *@
    <main class="flex-1 overflow-hidden p-3 min-h-0">
        <div @key="_activeTab" class="panel-enter h-full min-h-0">
            @switch (_activeTab)
            {
                case Tab.Live:
                    <LiveStream Conversations="MergedSessionConversations()" SelectedId="@_selectedConversationId" OnSelect="id => _selectedConversationId = id"/>
                    break;
                case Tab.Analytics:
                    <CostAnalytics Conversations="LiveDataStore.Conversations" InitialSessionId="@_selectedConversationId"/>
                    break;
                case Tab.Distribution:
                    <ModelDistribution/>
                    break;
                case Tab.Governance:
                    <Governance/>
                    break;
                case Tab.Console:
                    <ConsoleTab/>
                    break;
            }
        </div>
    </main>

    @* ── TOASTS ── *@
    <ToastHost/>

    @* ── SETTINGS MODAL ── *@
    @if (_showSettings)
    {
        <SettingsModal OnClose="() => _showSettings = false"/>
    }
</div>

@code {

    private enum Tab
    {
        Live,
        Analytics,
        Distribution,
        Governance,
        Console
    }

    private static readonly (Tab Tab, string Icon, string Label)[] Tabs =
    [
        (Tab.Live, "activity", "Sessions"),
        (Tab.Analytics, "bar-chart", "Cost Analytics"),
        (Tab.Distribution, "trending-up", "Model Distribution"),
        (Tab.Governance, "shield-check", "Governance"),
        (Tab.Console, "terminal", "Console")
    ];

    private Tab _activeTab = Tab.Live;

    // Sessions tab starts empty (no telemetry received yet); the Sessions page shows no cards
    // until a conversation arrives, so an empty starting id is correct rather than a mock fallback.
    private string _selectedConversationId = string.Empty;
    private bool _showSettings;

    // Provider keys whose monthly budget is breached / approaching (>=80%), derived from real budget state
    // published by ProviderAdminStore. Kept as lists so the banner markup's `.Count` reads unchanged.
    private List<string> _breached = [];
    private List<string> _approaching = [];

    // "12.4M"-style display for the header ticker's System Tokens tile - real, from UsageStore.Summary
    // (Phase 4, §5.15). Starts at the mock's placeholder value and only changes once a real summary loads,
    // so an unreachable proxy leaves the ticker showing what it always showed rather than a jarring "0".
    private string _systemTokensDisplay = "12.4M";

    protected override async Task OnInitializedAsync()
    {
        LiveDataStore.Changed += HandleLiveDataChanged;
        PersistedSessionStore.Changed += HandlePersistedSessionsChanged;
        ProviderStore.Changed += HandleProvidersChanged;
        await LiveDataStore.StartAsync();

        // Best-effort: populates the Sessions tab's persisted history. Failures are swallowed by the
        // store (surfaced via its IsReachable flag), so the tab simply shows only live sessions when the
        // proxy isn't running yet.
        await PersistedSessionStore.LoadAsync();

        // Best-effort: populates the budget banner. Failures are swallowed by the store (surfaced via its
        // IsReachable flag), so the dashboard renders "System Status: OK" when the proxy isn't running.
        await ProviderStore.LoadAsync();
        RecomputeBudgetAlerts();

        // Same best-effort shape: a failed/unavailable load just leaves the ticker's placeholder in place.
        await UsageStore.LoadSummaryAsync("all");
        if (UsageStore is { IsReachable: true, Summary: { } summary })
        {
            _systemTokensDisplay = FormatTokenCount(summary.PromptTokens + summary.CompletionTokens + summary.CacheCreationTokens + summary.CacheReadTokens);
        }
    }

    /// <summary>Abbreviates a token count for the ticker tile: "12.4M", "830.0K", or the bare number under 1,000.</summary>
    private static string FormatTokenCount(long tokens)
    {
        return tokens switch
        {
            >= 1_000_000 => FormattableString.Invariant($"{tokens / 1_000_000d:0.0}M"),
            >= 1_000 => FormattableString.Invariant($"{tokens / 1_000d:0.0}K"),
            _ => tokens.ToString(CultureInfo.InvariantCulture)
        };
    }

    // LiveDataStore raises Changed from whatever thread the gRPC stream delivered the event on;
    // InvokeAsync marshals back to this component's render context before calling StateHasChanged.
    /// <summary>Re-renders when live telemetry changes.</summary>
    private void HandleLiveDataChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // PersistedSessionStore raises Changed from whatever thread the gRPC call completed on, same as
    // LiveDataStore.Changed above.
    /// <summary>Re-renders when the Sessions tab's persisted history changes.</summary>
    private void HandlePersistedSessionsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The Sessions tab's full conversation list: every live session plus every persisted session not
    /// already present live, live winning for any session id in both - a session still in flight is more
    /// current from the live stream (turns arrive incrementally), while a persisted-only session survived
    /// a GUI restart and has nothing more current to prefer (docs/router/sessions-tab-training-data-plan.md
    /// Phase 2). Deliberately not cached: both source lists are already cheap, already-materialized
    /// snapshots (<see cref="LiveDataStore.Conversations"/>/<see cref="PersistedSessionStore.Sessions"/>
    /// are replaced wholesale on change, not mutated in place), so recomputing this on every render is a
    /// small, bounded cost rather than a stale-cache risk.
    /// </summary>
    private IReadOnlyList<Conversation> MergedSessionConversations()
    {
        var live = LiveDataStore.Conversations;
        if (PersistedSessionStore.Sessions.Count == 0)
        {
            return live;
        }

        var liveIds = new HashSet<string>(collection: live.Select(c => c.Id), comparer: StringComparer.Ordinal);
        var merged = new List<Conversation>(live);
        merged.AddRange(PersistedSessionStore.Sessions.Where(c => !liveIds.Contains(c.Id)));
        return merged;
    }

    /// <summary>Recomputes the budget-alert banner and re-renders when the provider list changes.</summary>
    private void HandleProvidersChanged()
    {
        InvokeAsync(() =>
        {
            RecomputeBudgetAlerts();
            StateHasChanged();
        });
    }

    // A provider counts as breached when a set cap is met/exceeded, and approaching when its highest
    // dimension utilization is in [80%, 100%). Providers with no caps are ignored.
    /// <summary>Re-derives <see cref="_breached"/> and <see cref="_approaching"/> from the current provider list.</summary>
    private void RecomputeBudgetAlerts()
    {
        _breached = ProviderStore.Providers
            .Where(p => Utilization(p) >= 100d)
            .Select(p => p.Key)
            .ToList();
        _approaching = ProviderStore.Providers
            .Where(p =>
            {
                var pct = Utilization(p);
                return pct is >= 80d and < 100d;
            })
            .Select(p => p.Key)
            .ToList();
    }

    // The provider's worst-case utilization across whichever of its two caps are set; -1 when unbudgeted so
    // it never trips either alert.
    /// <summary>Computes a provider's worst-case budget utilization percentage across its dollar and token caps.</summary>
    private static double Utilization(ProviderAdminView p)
    {
        // A zero cap is treated as 100% (immediately breached), matching the backend's spend >= cap rule, so
        // the banner never reads "OK" for a provider that enforcement is actually rejecting.
        var worst = -1d;
        if (p.DollarCap is { } dollarCap)
        {
            worst = Math.Max(val1: worst, val2: dollarCap <= 0m ? 100d : (double)(p.DollarSpent / dollarCap * 100m));
        }

        if (p.TokenCap is { } tokenCap)
        {
            worst = Math.Max(val1: worst, val2: tokenCap <= 0 ? 100d : (double)p.TokensUsed / tokenCap * 100d);
        }

        return worst;
    }

    public void Dispose()
    {
        LiveDataStore.Changed -= HandleLiveDataChanged;
        PersistedSessionStore.Changed -= HandlePersistedSessionsChanged;
        ProviderStore.Changed -= HandleProvidersChanged;
    }

    // Clicking the alert banner jumps to the Governance tab's Providers view, where each over-budget
    // provider's card shows its caps, spend, and utilization bars.
    /// <summary>Switches the active tab to Governance in response to the header alert banner being clicked.</summary>
    private void HandleAlertClick()
    {
        _activeTab = Tab.Governance;
    }

}