@* Shared overlay shell implementing the "System Settings" pattern documented in
   docs/gui/DESIGN.md §4.1: the .overlay-backdrop/.overlay-panel skeleton, a header bar with an
   uppercase title and a close glyph, and the scrollable .overlay-content body. Every dialog/modal/
   window in this app is expected to build on this shell rather than hand-rolling its own chrome, so
   the backdrop-dismiss, stop-propagation, header layout, and (optionally) Escape-to-close behavior stay
   identical everywhere instead of being copy-pasted and drifting per dialog. *@
<div class="overlay-backdrop fixed inset-0 z-50 flex items-center justify-center"
     @onmousedown="RememberBackdropPress"
     @onmouseup="HandleBackdropMouseUp">
    <div class="overlay-panel w-full max-w-md rounded-lg border border-slate-700"
         tabindex="@(EnableEscapeToClose ? "-1" : null)"
         @onkeydown="HandlePanelKeyDown"
         @onmousedown="ClearBackdropPress"
         @onmousedown:stopPropagation="true"
         @onmouseup="ClearBackdropPress"
         @onmouseup:stopPropagation="true"
         @onclick:stopPropagation="true">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700">
            <span class="text-sm font-semibold text-slate-200 tracking-wide uppercase">@Title</span>
            <button @onclick="OnClose"
                    aria-label="@CloseAriaLabel"
                    class="text-slate-400 hover:text-slate-200 transition-colors">
                <Icon Name="x" Size="20"/>
            </button>
        </div>

        <div class="@ContentClass">
            @ChildContent
        </div>
    </div>
</div>

@code {

    /// <summary>The uppercase header title, e.g. "System Settings" or "Remove Provider".</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// The close button's accessible name. The button's only content is an <see cref="Icon"/>
    /// SVG, so per docs/gui/DESIGN.md §4.1 it must carry an <c>aria-label</c> or a screen reader
    /// announces an unnamed button.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string CloseAriaLabel { get; set; } = string.Empty;

    /// <summary>
    /// Invoked when the dialog should close: a primary-button press and release that both land on
    /// the backdrop, the close glyph, and - when <see cref="EnableEscapeToClose"/> is set - the
    /// Escape key. A release on the backdrop after a press inside the panel does not close, so
    /// selecting text past the dialog edge leaves it open. The shell never closes itself; the
    /// caller decides what closing means (dismiss an edit, cancel a confirmation, etc.).
    /// </summary>
    [Parameter]
    [EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>The dialog's body, rendered inside the scrollable <c>.overlay-content</c> wrapper.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The CSS classes on the <c>.overlay-content</c> body wrapper - callers vary the
    /// <c>space-y-*</c> gap between blocks (e.g. <c>space-y-3</c> for <c>ProviderEditDialog</c>'s denser
    /// header-row layout) while keeping the <c>overlay-content p-5</c> base identical.
    /// </summary>
    [Parameter]
    public string ContentClass { get; set; } = "overlay-content p-5 space-y-4";

    /// <summary>
    /// Whether Escape closes the dialog, bound on the panel (not the body) so it fires
    /// regardless of which descendant control currently has focus. Off by default: only dialogs that
    /// confirmed this behavior before the shell existed (<c>RemoveProviderDialog</c>,
    /// <c>UnlockSecretFieldDialog</c>) opt in - adding it elsewhere would be an observable behavior
    /// change, not a pure refactor.
    /// </summary>
    [Parameter]
    public bool EnableEscapeToClose { get; set; }

    /// <summary>
    /// True after a primary-button press whose target was the backdrop itself. The panel stops
    /// pointer events from bubbling, so a press that starts inside the dialog never sets this.
    /// </summary>
    private bool _pressedOnBackdrop;

    /// <summary>
    /// Closes the dialog when Escape is pressed anywhere within the panel, but only when
    /// <see cref="EnableEscapeToClose"/> opts in.
    /// </summary>
    private async Task HandlePanelKeyDown(KeyboardEventArgs args)
    {
        if (EnableEscapeToClose && args.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    /// <summary>
    /// Records that the current gesture began on the backdrop. A text selection that starts inside
    /// the panel and ends on the backdrop would otherwise dismiss the dialog: the browser dispatches
    /// the resulting <c>mouseup</c> (and the synthesized <c>click</c>) on the backdrop, the nearest
    /// common ancestor, which a bare backdrop <c>@onclick</c> treats as a click-outside.
    /// </summary>
    /// <param name="args">The backdrop's pointer-down event.</param>
    private void RememberBackdropPress(MouseEventArgs args)
    {
        _pressedOnBackdrop = args.Button == 0;
    }

    /// <summary>
    /// Forgets a backdrop press when the pointer is pressed or released inside the panel, so a
    /// gesture that crosses the panel boundary does not dismiss on a later backdrop <c>mouseup</c>.
    /// </summary>
    private void ClearBackdropPress()
    {
        _pressedOnBackdrop = false;
    }

    /// <summary>
    /// Dismisses only when the same primary-button gesture both started and ended on the backdrop.
    /// Releasing outside after selecting text inside the dialog leaves it open.
    /// </summary>
    /// <param name="args">The backdrop's pointer-up event.</param>
    private async Task HandleBackdropMouseUp(MouseEventArgs args)
    {
        var shouldClose = _pressedOnBackdrop && args.Button == 0;
        _pressedOnBackdrop = false;
        if (shouldClose)
        {
            await OnClose.InvokeAsync();
        }
    }

}