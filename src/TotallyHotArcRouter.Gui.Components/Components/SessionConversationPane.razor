@* Chronological chat-style reproduction of a session's turns: a labeled separator (turn number,
   agent chip, model, timestamp) followed by a request bubble (left) and a response bubble (right),
   tinted with the turn's agent color. Rendered in the right pane of the Sessions split view (LiveStream.razor) once a
   session is opened via double-click on its card. *@
<div class="flex-1 overflow-y-auto space-y-3 pr-1">
    @foreach (var turn in OrderedTurns)
    {
        <div @key="turn.Id" class="space-y-1.5">
            <div class="ls-chat-turn-separator flex items-center gap-2 flex-wrap">
                <span>Turn @turn.TurnNumber</span>
                <span class="shrink-0 rounded px-1.5 py-0.5 font-semibold normal-case"
                      style="background:@(AgentColorFor(turn))22;color:@AgentColorFor(turn);border:1px solid @(AgentColorFor(turn))44">
                    @turn.Agent
                </span>
                <span class="font-mono normal-case">@turn.Model</span>
                @if (!string.IsNullOrEmpty(turn.SubagentSignal))
                {
                    @* ADR-0021: which harness marker the request carried (e.g. claude-code/explore). Absent
                       for an unsignalled request, or one from an older router that never sends the field. *@
                    <span class="ls-signal-badge shrink-0 rounded px-1.5 py-0.5 font-semibold normal-case"
                          title="Marked by the client as a subagent or side task">@turn.SubagentSignal</span>
                }
                <span class="font-mono normal-case ml-auto">@turn.Timestamp</span>
            </div>

            @* Locked (ADR-0020): the router withholds the text, so an empty bubble means "hidden", not
               "never captured" - say so, or the operator would read a locked session as an empty one. *@
            <div class="rounded px-3 py-2 text-xs ls-chat-bubble-user @(HasRequest(turn) ? "text-slate-200" : "text-slate-500 italic")">
                @(HasRequest(turn) ? turn.RequestSummary : EmptyRequestText)
            </div>

            <div class="rounded px-3 py-2 text-xs ls-chat-bubble-model @(HasResponse(turn) ? "text-slate-200" : "text-slate-500 italic")"
                 style="border-right:3px solid @AgentColorFor(turn)">
                @(HasResponse(turn) ? turn.ResponseSummary : EmptyResponseText)
            </div>
        </div>
    }
</div>

@code {

    /// <summary>The conversation whose turns are reproduced as a chat-style thread.</summary>
    [Parameter]
    [EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    /// <summary>
    /// Whether conversation text is locked behind a passkey (ADR-0020). While locked, a turn with no text shows
    /// a "locked" placeholder instead of "No request captured", because the text exists but is withheld.
    /// </summary>
    [Parameter]
    public bool ContentLocked { get; set; }

    /// <summary>The placeholder for a turn with no request text.</summary>
    private string EmptyRequestText => ContentLocked ? "Locked - unlock with a passkey to view" : "No request captured";

    /// <summary>The placeholder for a turn with no response text.</summary>
    private string EmptyResponseText => ContentLocked ? "Locked - unlock with a passkey to view" : "No response captured";

    /// <summary><see cref="Conversation"/>'s turns in ascending <see cref="ConversationTurn.TurnNumber"/> order.</summary>
    private IEnumerable<ConversationTurn> OrderedTurns => Conversation.Turns.OrderBy(t => t.TurnNumber);

    /// <summary>
    /// The accent color for <paramref name="turn"/>'s agent, used to tint its separator chip and response bubble.
    /// </summary>
    private static string AgentColorFor(ConversationTurn turn)
    {
        return ChartPalette.ColorFor(turn.Agent);
    }

    /// <summary>Whether <paramref name="turn"/> captured a non-empty request summary.</summary>
    private static bool HasRequest(ConversationTurn turn)
    {
        return !string.IsNullOrWhiteSpace(turn.RequestSummary);
    }

    /// <summary>Whether <paramref name="turn"/> captured a non-empty response summary.</summary>
    private static bool HasResponse(ConversationTurn turn)
    {
        return !string.IsNullOrWhiteSpace(turn.ResponseSummary);
    }

}