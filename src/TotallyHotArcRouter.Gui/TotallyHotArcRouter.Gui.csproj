<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Windows-only .NET MAUI Blazor Hybrid app: a BlazorWebView hosts the Razor dashboard, and the
         window lives in the system tray (see Platforms/Windows/TrayWindowManager.cs). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TotallyHot.ArcRouter.Gui</RootNamespace>
    <UseMaui Condition="$([MSBuild]::IsOSPlatform('windows'))">true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Matches TotallyHotArcRouter.csproj/.Quality.csproj: CS1591 (missing XML doc on a public member)
         becomes a build error via TreatWarningsAsErrors, so undocumented public API can't creep back
         in. Razor-compiler-generated partial classes (BuildRenderTree etc.) are emitted with their own
         `#pragma warning disable 1591`, so this doesn't fight componentgen. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ApplicationTitle>TotallyHotArcRouter</ApplicationTitle>
    <ApplicationId>com.TotallyHotArcRouter.gui</ApplicationId>
    <!-- Derived from Directory.Build.props' shared <Version> (auto-update plan Phase 0) rather than
         hardcoded, so the GUI's displayed/compared version can never drift from the Router's.
         ApplicationDisplayVersion must stay a 3-part semver (matching Version exactly) - the
         Resizetizer's GeneratePackageAppxManifest task appends ApplicationVersion itself as the
         4th component when building the appx manifest version, so pre-padding it here produces
         a 4-part value the task then rejects. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Unpackaged (no MSIX) so `dotnet run` / F5 work without package registration or signing. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- GitHub's Ubuntu-hosted NuGet dependency-submission job restores every discovered project file,
         including this Windows-only MAUI app. Linux never builds this project in CI, but restore still
         needs to evaluate it so the dependency snapshot can include its package graph. Disabling the MAUI
         workload resolver avoids the unsupported maui-tizen probe on Linux, and EnableWindowsTargeting lets
         restore read this net10.0-windows project cross-platform without affecting the normal Windows build. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0f172a" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiles Directory.Build.props' UpdateGitHubOwner/UpdateGitHubRepo (auto-update plan) into
         assembly metadata so the GUI can resolve which release to check/install even when there's
         no reachable Router to ask (first-run/unreachable-fallback path) - matches
         TotallyHotArcRouter.csproj's identical copy of this ItemGroup. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateGitHubOwner</_Parameter1>
      <_Parameter2>$(UpdateGitHubOwner)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UpdateGitHubRepo</_Parameter1>
      <_Parameter2>$(UpdateGitHubRepo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.100" />
    <!-- Lets the tray read the real Windows service state (Platforms/Windows/TrayWindowManager.cs) instead
         of inferring it from whether a gRPC poll succeeded, which is what made it report a running service
         as stopped. Windows-only, which this project already is. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
    <!-- Charts: Apache ECharts (echarts.min.js, Apache-2.0) is vendored under
         wwwroot/lib/echarts and driven by wwwroot/js/echarts-interop.js, so charts work offline in the
         BlazorWebView with no NuGet chart dependency. See docs/gui/cost-analytics-visualization-spec.md. -->
    <!-- Logging (AGENTS.md: Serilog exclusively, configured via appsettings.json). Versions match
         TotallyHotArcRouter.csproj's so the two processes cannot end up on different Serilog behavior.
         No Sinks.Console here, unlike the Router: this is a WinExe with no console attached. See
         Services/GuiLogging.cs. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Direct, though .NET MAUI already pulls this in transitively: GuiLogging reads appsettings.json
         through it, and a transitive dependency is not a contract this project should build on. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Update (not Include): the SDK's default None glob already matches this file, so including it
         again fails with NETSDK1022. Copied to the output - and therefore into the publish directory the
         MSI harvests with <Files Include="$(var.GuiPublishDir)\**"> - so the installed GUI reads the same
         Serilog configuration a development build does. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- MockData's literal fixture data (Models/DashboardData.cs) lives here instead of as C# object
         initializers; embedded (not copied to output) so Models/DashboardData.cs's LoadFixture reads it
         via Assembly.GetManifestResourceStream regardless of the process's working directory - unlike
         appsettings.json above, this never needs to be edited by hand outside the build, so there is no
         reason to expose it as a loose file next to the executable. -->
    <EmbeddedResource Include="Models\DashboardMockData.json">
      <LogicalName>TotallyHot.ArcRouter.Gui.Models.DashboardMockData.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Plain net10.0 libraries: pure data-transformation logic kept out of this Windows-only
         project so it's unit-testable on any platform. See the matching .Tests projects.
         TotallyHotArcRouter.Gui.Telemetry also compiles Protos/telemetry.proto's gRPC client stub
         (GrpcChannel/TelemetryServiceClient/Contract.* types Services/LiveDataStore.cs uses) - not
         this project directly - because .NET MAUI's SingleProject build doesn't reliably run
         Grpc.Tools' codegen; see TotallyHotArcRouter.Gui.Telemetry.csproj's comment for why. Grpc.Net.Client/
         Google.Protobuf therefore reach this project transitively through that ProjectReference,
         with no PackageReference of their own needed here. -->
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Admin\TotallyHotArcRouter.Gui.Admin.csproj" />
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Charts\TotallyHotArcRouter.Gui.Charts.csproj" />
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Console\TotallyHotArcRouter.Gui.Console.csproj" />
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Telemetry\TotallyHotArcRouter.Gui.Telemetry.csproj" />
  </ItemGroup>

</Project>
