{
  // The GUI's own Serilog configuration, deliberately separate from the Router's
  // src/TotallyHotArcRouter/appsettings.json. The two processes run as different identities - the Router
  // as LocalSystem under the service control manager, the GUI as the interactive user - so they cannot
  // share one log file without one of them losing the write race or being denied outright. The Router
  // keeps C:\Logs\ArcRouter\arcrouter-.log; the GUI writes under the same per-user root
  // GuiSettingsStore already uses, which the interactive user always owns.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        // The GUI's own services (LiveDataStore, the admin stores) log their connection lifecycles at
        // Debug, which is what makes a "the dashboard shows nothing" report diagnosable after the fact.
        "TotallyHot.ArcRouter.Gui": "Debug",
        // .NET MAUI's own WebView2 host logs StartingWebView2/StartedWebView2 at Debug and
        // "Failed to create WebView2 environment" at Error from this category. That error is the exact
        // failure that produced a blank dashboard window with nothing written anywhere, so this override
        // deliberately reaches past the "Microsoft": "Warning" line above to keep the successful case
        // visible too - a missing StartedWebView2 line is itself the diagnosis.
        "Microsoft.AspNetCore.Components.WebView": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          // %LOCALAPPDATA% is expanded by GuiLogging before Serilog reads this, and an unresolvable
          // variable falls back to the per-user path in code - a literal "%LOCALAPPDATA%" folder
          // relative to the working directory would be unfindable, and for a Run-key launch the working
          // directory is not even the install folder.
          "path": "%LOCALAPPDATA%\\TotallyHotArcRouter\\logs\\arcrouter-gui-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
