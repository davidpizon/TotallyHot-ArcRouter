@* Cost Analytics tab: a metric explorer. The user picks one of the seven ranked Perf/$ metrics, a time
   range (hour/day/week/month/all-time), and optionally a single session; each metric renders in its own
   bespoke Apache ECharts format per docs/gui/cost-analytics-visualization-spec.md (dual-directional ROI
   bars, stepped cumulative cost, token-runaway detection, segmented tool-step bars, cache/latency/context
   lines). The per-metric chart model is built by the pure, unit-tested TotallyHot.ArcRouter.Gui.Charts.
   CostChartBuilder and rendered through the shared <EChart> host. History is real, rollup-backed data
   (Phase 4, §5.15) fetched from UsageStore on load - so charts survive a GUI restart - merged with live
   turns from LiveDataStore; MockData.BuildMetricHistory is only the offline/no-proxy fallback, used when
   there's neither. *@
@inject UsageStore UsageStore
@implements IDisposable
<div class="h-full flex flex-col gap-3 min-h-0">
    @* ── CONTROL BAR ── *@
    <div class="rounded-lg p-3 shrink-0 flex flex-col gap-3 ds-surface-card-bordered">
        @* Metric selector (ranked by priority, left-to-right) *@
        <div class="flex flex-wrap items-center gap-1.5">
            @foreach (var def in MetricDefs)
            {
                var metric = def.Metric;
                var isActive = _metric == metric;
                <button @onclick="() => SelectMetric(metric)"
                        title="@def.Description"
                        class="metric-button @(isActive ? "active" : "inactive")">
                    @def.Label
                </button>
            }
        </div>

        @* Time range + session scope *@
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-1" role="group" aria-label="Time range">
                @foreach (var (range, label) in Ranges)
                {
                    var r = range;
                    var isActive = _range == r;
                    <button @onclick="() => SelectRange(r)"
                            class="metric-button @(isActive ? "active" : "inactive")">
                        @label
                    </button>
                }
            </div>

            <div class="w-px h-4 ds-divider"></div>

            <select value="@_sessionScope"
                    @onchange="OnSessionChanged"
                    class="px-2 py-1.5 text-xs font-mono ds-input">
                <option value="">All Sessions</option>
                @foreach (var (id, label) in SessionOptions)
                {
                    <option value="@id">@label</option>
                }
            </select>
        </div>
    </div>

    @* ── CHART ── *@
    <div class="rounded-lg p-4 flex-1 min-h-0 flex flex-col ds-surface-card-bordered">
        <div class="flex items-baseline justify-between mb-3 shrink-0">
            <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">@_model.Title</div>
                <div class="text-xs text-slate-600 mt-0.5">@CurrentDef.Description · @RangeCaption</div>
            </div>
            <div class="font-mono text-lg font-semibold mt-0.5 metric-accent">@_model.Headline</div>
        </div>

        @if (_model.Points.Count == 0)
        {
            <div class="flex-1 flex items-center justify-center text-xs text-slate-500">
                No data for this metric in the selected range.
            </div>
        }
        else
        {
            <div class="flex-1 min-h-0">
                <EChart ModelJson="@_modelJson"/>
            </div>

            @* Model legend (shared color mapping across every metric). *@
            @if (_model.Models.Count > 0)
            {
                <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 justify-center shrink-0">
                    @foreach (var m in _model.Models)
                    {
                        <div class="flex items-center gap-1.5 text-xs font-mono text-slate-400">
                            <span class="w-2 h-2 rounded-sm shrink-0" style="background:@m.Color"></span>
                            @m.Model
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {

    /// <summary>
    /// Live conversations from LiveDataStore (same source as the Live Stream tab). Their turns supply
    /// real tokens/cost/TTFT/model/timestamp; MockData.BuildMetricHistory fills the rest.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<Conversation> Conversations { get; set; } = [];

    /// <summary>
    /// Session the Live Stream tab currently has selected, used as the initial scope so the two tabs stay
    /// in sync when the user switches over. Null/empty means show all sessions.
    /// </summary>
    [Parameter]
    public string? InitialSessionId { get; set; }

    /// <summary>
    /// One metric pill's display definition: which <see cref="CostMetric"/> it selects, its button label, and its
    /// tooltip/subtitle description.
    /// </summary>
    private sealed record MetricDef(CostMetric Metric, string Label, string Description);

    // Ranked by business priority (the order the pills appear in), matching the CostMetric enum. The
    // description doubles as the pill tooltip and the chart subtitle.
    private static readonly MetricDef[] MetricDefs =
    [
        new(Metric: CostMetric.RoutingRoi, Label: "Routing ROI", Description: "Estimated savings vs. the frozen 9-dimension baseline: gains above 0, losses below"),
        new(Metric: CostMetric.TotalTurnCost, Label: "Turn Cost", Description: "Stepped cumulative cost, area colored by the active model"),
        new(Metric: CostMetric.Tokens, Label: "Tokens", Description: "Cumulative tokens with exponential-runaway detection"),
        new(Metric: CostMetric.ToolExecutionSteps, Label: "Tool Steps", Description: "Per-turn step bars, segmented by the model that handled each stretch"),
        new(Metric: CostMetric.CacheHitRate, Label: "Cache Hit", Description: "Stepped cache-hit-rate line with a gradient track"),
        new(Metric: CostMetric.TimeToFirstToken, Label: "TTFT", Description: "Latency line over per-model background zones; spikes pinned"),
        new(Metric: CostMetric.ContextBufferMargin, Label: "Context", Description: "Context-window fill with a 90% safety threshold")
    ];

    private static readonly (MetricRange Range, string Label)[] Ranges =
    [
        (MetricRange.Hour, "Hour"),
        (MetricRange.Day, "Day"),
        (MetricRange.Week, "Week"),
        (MetricRange.Month, "Month"),
        (MetricRange.AllTime, "All")
    ];

    private CostMetric _metric = CostMetric.RoutingRoi;
    private MetricRange _range = MetricRange.Week;
    private string _sessionScope = string.Empty;

    // The Routing ROI metric alone is fed by the router's taxonomy-comparison store rather than by live
    // turns or usage rollups (docs/router/self-organizing-classification-plan.md Phase T4). That data is
    // produced by a background job, so it is polled on an interval instead of arriving with telemetry.
    private static readonly TimeSpan RoiPollInterval = TimeSpan.FromSeconds(30);

    private IReadOnlyList<MetricTurnPoint> _corpus = [];
    private IReadOnlyList<MetricTurnPoint> _rollupHistory = [];
    private IReadOnlyList<MetricTurnPoint> _roiHistory = [];
    private Timer? _roiPollTimer;
    private CostChartModel _model = new(Kind: CostChartKind.DualDirectionalBars, Title: "Routing ROI", Unit: "$", Headline: "—", null, Models: [], Points: []);
    private string _modelJson = "{}";

    /// <summary>The display definition for the currently selected metric.</summary>
    private MetricDef CurrentDef => MetricDefs.First(d => d.Metric == _metric);

    protected override void OnInitialized()
    {
        // Only seed the initial session scope here; the first compute happens in OnParametersSet, which
        // Blazor always calls right after OnInitialized on the first render - so we avoid computing the
        // corpus/model twice during initialization.
        if (!string.IsNullOrEmpty(InitialSessionId))
        {
            _sessionScope = InitialSessionId;
        }
    }

    // Fetched once on load (not re-fetched per filter change - UsageStore's own cache would serve a repeat
    // call instantly anyway, but there's no reason to re-request the same wide range every render). The
    // retention-matching 370-day span is what the ledger itself is bounded to
    // (Storage:UsageLedgerRetentionDays), so this asks for exactly as much history as could exist.
    protected override async Task OnInitializedAsync()
    {
        // Aligned to the start of the current UTC day, not DateTimeOffset.UtcNow - rollups are stored at
        // day granularity and an in-progress bucket is always excluded (UsageRollupStore's
        // never-publish-the-in-progress-bucket rule), so an unaligned 'from' can land after the earliest
        // fully-elapsed day bucket's start and drop it from the range.
        var todayStartUtc = new DateTimeOffset(dateTime: DateTimeOffset.UtcNow.Date, offset: TimeSpan.Zero);
        var buckets = await UsageStore.LoadRollupAsync(from: todayStartUtc.AddDays(-370), to: todayStartUtc, width: "day", groupBy: "day");
        _rollupHistory = buckets
            .OrderBy(b => b.BucketStartUtc)
            .Select(b => new MetricTurnPoint(
                TimestampUtc: b.BucketStartUtc,
                SessionId: FormattableString.Invariant($"rollup:{b.BucketStartUtc:yyyy-MM-dd}"),
                Model: string.Empty,
                null,
                TotalCost: b.CostUsd,
                PromptTokens: (int)Math.Min(val1: b.PromptTokens, val2: int.MaxValue),
                CompletionTokens: (int)Math.Min(val1: b.CompletionTokens, val2: int.MaxValue),
                0,
                CacheHitRate: CostChartBuilder.CacheHitRate(
                    promptTokens: (int)Math.Min(val1: b.PromptTokens, val2: int.MaxValue),
                    cacheCreationTokens: (int)Math.Min(val1: b.CacheCreationTokens, val2: int.MaxValue),
                    cacheReadTokens: (int)Math.Min(val1: b.CacheReadTokens, val2: int.MaxValue)),
                0,
                0m))
            .ToList();

        await RefreshRoiAsync();
        _roiPollTimer = new Timer(callback: _ => _ = PollRoiAsync(), null, dueTime: RoiPollInterval, period: RoiPollInterval);
        Recompute();
    }

    /// <summary>
    /// Re-fetches the Routing ROI feed and repaints, on the poll timer. Swallows nothing itself -
    /// <see cref="UsageStore.LoadRoutingRoiAsync"/> already degrades an unreachable proxy to an empty
    /// list - but runs through <c>InvokeAsync</c> because the timer fires off the renderer's thread.
    /// </summary>
    private async Task PollRoiAsync()
    {
        await InvokeAsync(async () =>
        {
            await RefreshRoiAsync();
            Recompute();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Loads the routing-ROI comparison points for the full retained window and projects them onto the
    /// chart's point shape. Only the fields the ROI chart reads are populated - these rows describe a
    /// routing decision's cost counterfactual, not a turn's token or latency profile.
    /// </summary>
    private async Task RefreshRoiAsync()
    {
        var todayStartUtc = new DateTimeOffset(dateTime: DateTimeOffset.UtcNow.Date, offset: TimeSpan.Zero);
        var points = await UsageStore.LoadRoutingRoiAsync(from: todayStartUtc.AddDays(-370), to: todayStartUtc.AddDays(1));
        _roiHistory = points
            .OrderBy(p => p.ComparedAtUtc)
            .Select(p => new MetricTurnPoint(
                TimestampUtc: p.ComparedAtUtc,
                SessionId: p.SessionId,
                Model: p.RoutedModel,
                BaselineCostUsd: p.BaselineEstimatedCostUsd,
                TotalCost: p.ActualCostUsd ?? 0m,
                0,
                0,
                0,
                0m,
                0,
                0m,
                BaselineModel: p.BaselineModel,
                IsExploratory: p.IsExploratory))
            .ToList();
    }

    /// <summary>Stops the Routing ROI poll timer when the tab is torn down.</summary>
    public void Dispose()
    {
        _roiPollTimer?.Dispose();
    }

    // Runs right after OnInitialized on first render, and again whenever the Dashboard re-renders on
    // LiveDataStore.Changed (new live telemetry) - keeps the chart auto-refreshing as new turns arrive.
    protected override void OnParametersSet()
    {
        Recompute();
    }

    /// <summary>Switches the active metric pill and recomputes the chart.</summary>
    private void SelectMetric(CostMetric metric)
    {
        _metric = metric;
        Recompute();
    }

    /// <summary>Switches the active time range and recomputes the chart.</summary>
    private void SelectRange(MetricRange range)
    {
        _range = range;
        Recompute();
    }

    /// <summary>Applies the session-scope dropdown's selection and recomputes the chart.</summary>
    private void OnSessionChanged(ChangeEventArgs e)
    {
        _sessionScope = (string?)e.Value ?? string.Empty;
        Recompute();
    }

    /// <summary>Rebuilds the corpus and chart model for the current metric/range/session selection.</summary>
    private void Recompute()
    {
        var now = DateTimeOffset.UtcNow;
        _corpus = BuildCorpus(now);
        _model = CostChartBuilder.Build(
            points: _corpus, metric: _metric, range: _range, sessionId: string.IsNullOrEmpty(_sessionScope) ? null : _sessionScope, now: now);
        _modelJson = ChartJson.Serialize(_model);
    }

    // Merges live turns (real data) with rollup-backed history (also real, and what survives a GUI
    // restart) on the same time axis; the session scope dropdown lets the user isolate one. MockData only
    // fills in when there is neither - the offline/no-proxy demo path.
    /// <summary>
    /// Builds the point corpus the chart model is derived from, combining rollup history, live turns, and (as a last
    /// resort) mock data.
    /// </summary>
    private IReadOnlyList<MetricTurnPoint> BuildCorpus(DateTimeOffset now)
    {
        // Routing ROI has its own corpus: one point per compared routing decision, carrying the baseline
        // counterfactual nothing else in this tab has. Live turns and usage rollups cannot contribute -
        // neither knows what the frozen baseline would have chosen - so merging them in would only add
        // points the ROI chart must skip. The mock fallback follows the same rule as the rest of the tab:
        // demo data only when there is nothing real at all, never alongside live sessions.
        if (_metric == CostMetric.RoutingRoi)
        {
            return _roiHistory.Count > 0 ? _roiHistory
                : Conversations.Count == 0 ? MockData.BuildMetricHistory(now)
                : [];
        }

        var points = new List<MetricTurnPoint>();

        if (_rollupHistory.Count > 0)
        {
            points.AddRange(_rollupHistory);
        }
        else if (Conversations.Count == 0)
        {
            points.AddRange(MockData.BuildMetricHistory(now));
        }

        foreach (var conversation in Conversations)
        {
            foreach (var turn in conversation.Turns)
            {
                points.Add(new MetricTurnPoint(
                    TimestampUtc: turn.TimestampUtc,
                    SessionId: conversation.Id,
                    Model: turn.Model,
                    null,
                    TotalCost: turn.TotalCost,
                    PromptTokens: turn.PromptTokens,
                    CompletionTokens: turn.CompletionTokens,
                    ToolExecutionSteps: turn.ToolExecutionSteps,
                    CacheHitRate: turn.CacheHitRate,
                    TimeToFirstTokenMs: turn.TimeToFirstTokenMs,
                    ContextBufferPercent: turn.ContextBufferPercent));
            }
        }

        return points;
    }

    // ── Session dropdown options ──
    // Live conversations first (with their titles), then the mock demo sessions. Rollup-backed history
    // points are per-day aggregates, not real sessions - they're excluded here (they still count toward
    // "All Sessions") since offering "rollup:2026-08-07" as something to isolate wouldn't mean anything.
    /// <summary>The session-scope dropdown's options: every live conversation, followed by any mock demo sessions.</summary>
    private IEnumerable<(string Id, string Label)> SessionOptions
    {
        get
        {
            foreach (var conversation in Conversations)
            {
                yield return (conversation.Id, conversation.Title);
            }

            var liveIds = Conversations.Select(c => c.Id).ToHashSet(StringComparer.Ordinal);
            var demoIds = _corpus
                .Select(p => p.SessionId)
                .Where(id => !liveIds.Contains(id) && !id.StartsWith(value: "rollup:", comparisonType: StringComparison.Ordinal))
                .Distinct(StringComparer.Ordinal)
                .OrderBy(keySelector: id => id, comparer: StringComparer.Ordinal);
            var n = 1;
            foreach (var id in demoIds)
            {
                yield return (id, $"Demo session {n++:D2}");
            }
        }
    }

    /// <summary>The chart subtitle's human-readable label for the currently selected time range.</summary>
    private string RangeCaption => _range switch
    {
        MetricRange.Hour => "Past hour",
        MetricRange.Day => "Past 24 hours",
        MetricRange.Week => "Past 7 days",
        MetricRange.Month => "Past 30 days",
        _ => "All time"
    };

}