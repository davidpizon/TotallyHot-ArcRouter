@* Governance > Providers pane: add/remove/edit provider endpoints + credentials and manage each
   provider's models (with live /v1/models discovery). Talks to the proxy's /admin API via the
   injected ProviderAdminStore. *@
@implements IDisposable
@inject ProviderAdminStore Store
@using System.Linq
@using TotallyHot.ArcRouter.Gui.Admin

<div class="h-full overflow-y-auto pr-1">
    @if (!Store.IsLoaded)
    {
        <div class="text-sm text-slate-500 p-4">Loading providers…</div>
    }
    else if (!Store.IsReachable)
    {
        <div class="rounded-lg p-4 space-y-2 ds-surface-card-critical">
            <div class="flex items-center gap-2 text-sm text-red-400 font-semibold">
                <Icon Name="alert-triangle" Size="20" /> Proxy management API unreachable
            </div>
            <div class="text-xs text-slate-400">
                Could not reach <span class="font-mono">@ProviderAdminStore.DefaultManagementAddress</span>. Is the proxy running?
            </div>
            @if (!string.IsNullOrEmpty(Store.LastError))
            {
                <div class="text-xs text-slate-500 font-mono">@Store.LastError</div>
            }
            <button @onclick="Reload"
                    class="btn btn-ghost">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs text-slate-500 uppercase tracking-widest">Configured Providers</span>
            <button @onclick="OpenAdd"
                    class="btn btn-secondary flex items-center gap-1.5">
                <Icon Name="plus" Size="20" /> Add Provider
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_opError))
        {
            <div class="rounded px-3 py-2 mb-3 text-xs ds-step-critical">
                @_opError
            </div>
        }

        <div class="ds-card-stack">
            @foreach (var provider in Store.Providers)
            {
                @* A stopped provider dims its border and title, matching PriceSourcesAdmin's disabled
                   cards. The proxy's routing path skips a stopped provider on the very next request. *@
                <div @key="provider.Key" class="rounded-lg p-3 @(provider.Enabled ? "ds-surface-card-bordered" : "ds-surface-card-bordered-dim")">
                    @* Header: key + endpoint + actions *@
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <Icon Name="server" Size="20" />
                                <span class="text-sm font-semibold @(provider.Enabled ? "state-enabled" : "state-disabled")">@(string.IsNullOrWhiteSpace(provider.Name) ? provider.Key : provider.Name)</span>
                                @* One pill per API flavor the last endpoint scan detected. Absent entirely
                                   until "Refresh" has run at least once (EndpointCapabilities is null until
                                   then), distinguishing "never scanned" from "scanned, nothing detected". *@
                                @foreach (var api in DetectedApis(provider.EndpointCapabilities))
                                {
                                    <span class="rounded px-1.5 py-0.5 text-[10px] uppercase tracking-wider font-semibold ds-badge-success">@api</span>
                                }
                                @* Persists until the next successful interaction with this provider (refresh,
                                   scan, or save) - see ManagementFacade.RefreshFromEndpointAsync's
                                   RecordRefreshOutcome. Reuses the shared floating tooltip rather than
                                   title= for the same clipping/keyboard reasons as the action buttons below. *@
                                @if (provider.LastInteraction is { Ok: false } failure)
                                {
                                    <span data-tip="@FailureTip(failure)" aria-describedby="ls-tooltip" class="text-amber-400 flex items-center">
                                        <Icon Name="alert-triangle" Size="16" />
                                    </span>
                                }
                            </div>
                            <div class="text-xs text-slate-500 mt-0.5 font-mono truncate">@provider.BaseUrl</div>
                        </div>
                        <div class="flex items-center gap-1 shrink-0">
                            <button title="Config" @onclick="() => OpenEdit(provider)"
                                    class="rounded p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-700 transition-colors">
                                <Icon Name="sliders" Size="20" />
                            </button>
                            @* Refreshes models and re-scans API capabilities in one call - see
                               RefreshFromEndpoint below. Shares the Stop/Play/Remove tooltip pattern rather
                               than title= for the same clipping/keyboard reasons. *@
                            <button @onclick="() => RefreshFromEndpoint(provider.Key)"
                                    data-tip="Refresh"
                                    aria-label="@($"Refresh provider {provider.Key}")"
                                    aria-describedby="ls-tooltip"
                                    class="rounded p-1.5 flex items-center justify-center ls-card-action">
                                <Icon Name="refresh" Size="20" />
                            </button>
                            @* Stop/Play and Remove use the shared floating tooltip (js/tooltips.js) rather
                               than title=, so the label isn't clipped by this pane's scroll container and
                               is reachable by keyboard. aria-label carries the accessible *name* - the
                               tooltip is only a description, and these buttons have no text. *@
                            <button @onclick="() => ToggleEnabled(provider)"
                                    data-tip="@(provider.Enabled ? "Stop" : "Play")"
                                    aria-label="@(provider.Enabled ? $"Stop provider {provider.Key}" : $"Start provider {provider.Key}")"
                                    aria-describedby="ls-tooltip"
                                    class="rounded p-1.5 flex items-center justify-center ls-card-action @(provider.Enabled ? "ls-card-action-stop" : "ls-card-action-play")">
                                <Icon Name="@(provider.Enabled ? "stop" : "play")" Size="20" />
                            </button>
                            <button @onclick="() => RemoveProvider(provider)"
                                    data-tip="Remove"
                                    aria-label="@($"Remove provider {provider.Key}")"
                                    aria-describedby="ls-tooltip"
                                    class="rounded p-1.5 flex items-center justify-center ls-card-action ls-card-action-remove">
                                <Icon Name="trash" Size="20" />
                            </button>
                        </div>
                    </div>

                    @* Models *@
                    <div class="mt-3 border-t border-slate-700/60 pt-2">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs text-slate-500 uppercase tracking-wider">Models</span>
                        </div>

                        @if (provider.Models.Count == 0)
                        {
                            <div class="text-xs text-slate-600 mb-1.5">No models configured.</div>
                        }
                        else
                        {
                            <div class="space-y-1 mb-1.5">
                                @foreach (var model in provider.Models)
                                {
                                    @* A model that's stopped (operator toggle) or not currently reported by
                                       the last "Refresh from endpoint" scan dims the same way a stopped
                                       provider does; "not detected" distinguishes the latter from a
                                       deliberate stop, mirroring the provider-level "stopped vs. unhealthy"
                                       distinction ProxyMiddleware already logs separately. *@
                                    <div @key="model.ModelName" class="flex items-center justify-between text-xs">
                                        <span class="font-mono @(model.Enabled && model.PresentUpstream ? "state-enabled subtle" : "state-disabled")">@model.ModelName</span>
                                        <div class="flex items-center gap-2">
                                            @if (!model.PresentUpstream)
                                            {
                                                <span class="text-[10px] uppercase tracking-wider text-amber-500">not detected</span>
                                            }
                                            @* How this model expresses tool calls. Empty until "Refresh from
                                               endpoint" has run, or the model has answered a real
                                               tools-carrying request. Editable because automatic detection
                                               can settle on a wrong answer that never self-corrects: an
                                               intermittently-native model gets recorded openai-native on its
                                               first lucky reply, after which nothing re-inspects it. Picking
                                               a value here pins it at operator confidence, which no scan may
                                               overwrite; "auto-detect" clears the pin. *@
                                            <select value="@(model.Dialect ?? string.Empty)"
                                                    @onchange="e => SetModelDialect(provider.Key, model.ModelName, e.Value?.ToString())"
                                                    aria-label="@($"Tool-call dialect for {model.ModelName}")"
                                                    title="@($"Tool-call dialect{(string.IsNullOrEmpty(model.Confidence) ? string.Empty : $" (confidence: {model.Confidence})")}")"
                                                    class="rounded bg-slate-800 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-slate-400 border border-slate-600">
                                                <option value="">auto-detect</option>
                                                @foreach (var dialect in ToolDialects)
                                                {
                                                    <option value="@dialect">@dialect</option>
                                                }
                                            </select>
                                            <span class="font-mono text-slate-500">@model.ProviderModelId</span>
                                            @* Start/Stop and Remove use the shared floating tooltip, mirroring the
                                               provider card's own Stop/Play + Trash pattern above. *@
                                            <button @onclick="() => ToggleModelEnabled(provider, model)"
                                                    data-tip="@(model.Enabled ? "Stop" : "Start")"
                                                    aria-label="@(model.Enabled ? $"Stop model {model.ModelName}" : $"Start model {model.ModelName}")"
                                                    aria-describedby="ls-tooltip"
                                                    class="rounded p-1 flex items-center justify-center ls-card-action @(model.Enabled ? "ls-card-action-stop" : "ls-card-action-play")">
                                                <Icon Name="@(model.Enabled ? "stop" : "play")" Size="16" />
                                            </button>
                                            <button title="Remove model" @onclick="() => RemoveModel(provider.Key, model.ModelName)"
                                                    class="text-red-400 hover:text-red-300 transition-colors">
                                                <Icon Name="x" Size="16" />
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* Manual add, for a provider "Refresh from endpoint" can't reach (no OpenAI-shaped
                           /v1/models - hosted Anthropic, Bedrock) or as a plain override. Collapsed by
                           default now that reconciliation adds most models automatically; mirrors the
                           expand/collapse pattern in TurnCard.razor (a per-key toggle + chevron glyph). *@
                        <button @onclick="() => ToggleAddModelPane(provider.Key)"
                                aria-expanded="@IsAddModelPaneOpen(provider.Key)"
                                aria-label="Add model manually"
                                class="w-full flex items-center justify-center text-xs text-slate-500 hover:text-slate-300 transition-colors">
                            <span aria-hidden="true">@(IsAddModelPaneOpen(provider.Key) ? "▴" : "▾")</span>
                        </button>

                        @* Always mounted so the pane can animate shut as well as open (the @if this
                           replaced unmounted it instantly). `inert` matters more here than on a
                           read-only disclosure: without it Tab would land in the two inputs and the
                           Add button while the pane is visually collapsed. *@
                        <div class="ls-disclosure @(IsAddModelPaneOpen(provider.Key) ? "open" : null)"
                             inert="@(!IsAddModelPaneOpen(provider.Key))">
                            <div>
                                <div class="flex items-center gap-1.5 mt-1.5">
                                    <input type="text" value="@GetDraft(_draftName, provider.Key)"
                                           @oninput="e => _draftName[provider.Key] = AsString(e.Value)"
                                           placeholder="model name"
                                           class="px-2 py-1 text-xs font-mono flex-1 min-w-0 ds-input" />
                                    <input type="text" value="@GetDraft(_draftId, provider.Key)"
                                           @oninput="e => _draftId[provider.Key] = AsString(e.Value)"
                                           placeholder="provider model id (optional)"
                                           class="px-2 py-1 text-xs font-mono flex-1 min-w-0 ds-input" />
                                    <button @onclick="() => AddModel(provider.Key)"
                                            class="btn-small-action shrink-0">
                                        Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Budget: optional monthly $ / token caps, current-month spend, and two utilization
                       bar charts (rendered only for a dimension that has a cap). *@
                    <div class="mt-3 border-t border-slate-700/60 pt-2">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs text-slate-500 uppercase tracking-wider">Monthly Budget</span>
                            <button @onclick="() => SaveBudget(provider.Key)"
                                    class="btn-small-action">
                                Save
                            </button>
                        </div>

                        <div class="flex items-center gap-1.5 mb-2">
                            <span class="text-xs font-mono text-slate-400">$</span>
                            <input type="text" value="@GetBudgetDraft(_draftDollarCap, provider.Key, provider.DollarCap?.ToString(CultureInfo.InvariantCulture))"
                                   @oninput="e => _draftDollarCap[provider.Key] = AsString(e.Value)"
                                   placeholder="monthly $ cap (optional)"
                                   class="px-2 py-1 text-xs font-mono flex-1 min-w-0 ds-input" />
                            <input type="text" value="@GetBudgetDraft(_draftTokenCap, provider.Key, provider.TokenCap?.ToString(CultureInfo.InvariantCulture))"
                                   @oninput="e => _draftTokenCap[provider.Key] = AsString(e.Value)"
                                   placeholder="monthly token cap (optional)"
                                   class="px-2 py-1 text-xs font-mono flex-1 min-w-0 ds-input" />
                        </div>

                        @if (provider.DollarCap is null && provider.TokenCap is null)
                        {
                            <div class="text-xs text-slate-600">No budget set — this provider is unlimited.</div>
                        }
                        else
                        {
                            <div class="grid grid-cols-2 gap-3">
                                @* Dollar utilization *@
                                <div>
                                    @if (provider.DollarCap is { } dollarCap)
                                    {
                                        var dollarPct = UtilizationPercent(provider.DollarSpent, dollarCap);
                                        <div class="flex justify-between text-xs font-mono text-slate-500 mb-1">
                                            <span>% $ spent</span>
                                            <span>$@Money2(provider.DollarSpent) / $@Money2(dollarCap)</span>
                                        </div>
                                        <div class="ls-provider-budget-chart">
                                            <EChart ModelJson="@BudgetBarJson("% $ spent", dollarPct)" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-600">No $ cap · $@Money2(provider.DollarSpent) spent</div>
                                    }
                                </div>

                                @* Token utilization *@
                                <div>
                                    @if (provider.TokenCap is { } tokenCap)
                                    {
                                        var tokenPct = UtilizationPercent(provider.TokensUsed, tokenCap);
                                        <div class="flex justify-between text-xs font-mono text-slate-500 mb-1">
                                            <span>% tokens utilized</span>
                                            <span>@provider.TokensUsed.ToString("N0", CultureInfo.InvariantCulture) / @tokenCap.ToString("N0", CultureInfo.InvariantCulture)</span>
                                        </div>
                                        <div class="ls-provider-budget-chart">
                                            <EChart ModelJson="@BudgetBarJson("% tokens utilized", tokenPct)" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-600">No token cap · @provider.TokensUsed.ToString("N0", CultureInfo.InvariantCulture) tokens used</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @* Usage: two sub-blocks with different provenance - estimated cost/tokens from
                       intercepted traffic (the cache-aware ledger) vs. the provider's own server-reported
                       rate-limit headers - kept visually distinct so the card never conflates the two
                       (docs/router/anthropic-reported-usage-plan.md §6). Anthropic- and OpenAI-typed
                       providers only (docs/router/openai-format-usage-accuracy-plan.md §6.2 generalizes
                       this beyond Anthropic); no IsEnterprise gate, since both data sources work for any
                       non-enterprise account. *@
                    @if (string.Equals(provider.ProviderType, "Anthropic", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(provider.ProviderType, "OpenAI", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mt-3 border-t border-slate-700/60 pt-2 space-y-2.5">
                            <span class="text-xs text-slate-500 uppercase tracking-wider">@provider.ProviderType Usage</span>

                            <div>
                                <div class="text-[10px] text-slate-600 uppercase tracking-wider mb-1">Estimated from intercepted traffic</div>
                                <div class="text-xs font-mono text-slate-400">
                                    $@Money2(provider.DollarSpent) spent · @provider.TokensUsed.ToString("N0", CultureInfo.InvariantCulture) tokens used
                                </div>
                                <div class="text-[10px] text-slate-600 mt-0.5">@FormatLastRecorded(provider.UsageLastRecordedAtUtc)</div>
                            </div>

                            <div>
                                <div class="text-[10px] text-slate-600 uppercase tracking-wider mb-1">Reported by @provider.ProviderType</div>
                                @if (provider.RateLimit is { } rateLimit)
                                {
                                    @foreach (var (dimensionName, dimension) in rateLimit.Snapshot.StandardDimensions.OrderBy(kvp => kvp.Key, StringComparer.Ordinal))
                                    {
                                        <div class="text-xs font-mono text-slate-400">@FormatDimension(dimensionName, dimension)</div>
                                        @if (rateLimit.Projections is not null && rateLimit.Projections.TryGetValue(dimensionName, out var projection))
                                        {
                                            <div class="text-[10px] text-sky-400/80 font-mono pl-2">@FormatBurnRate(projection)</div>
                                        }
                                    }
                                    @foreach (var (windowName, window) in rateLimit.Snapshot.UnifiedWindows.OrderBy(kvp => kvp.Key, StringComparer.Ordinal))
                                    {
                                        <div class="text-xs font-mono text-slate-400">@FormatWindow(windowName, window)</div>
                                    }
                                    <div class="text-[10px] mt-0.5 @(rateLimit.IsStale ? "text-slate-700" : "text-slate-600")">
                                        As of @FormatUtc(rateLimit.ObservedAtUtc)@(rateLimit.IsStale ? " · stale" : "")
                                    </div>

                                    @if (Store.RateLimitHistory.TryGetValue(provider.Key, out var history) && history.Dimensions is { Count: > 0 })
                                    {
                                        @foreach (var (dimensionName, points) in history.Dimensions.OrderBy(kvp => kvp.Key, StringComparer.Ordinal))
                                        {
                                            <div class="ls-provider-trend-chart">
                                                <EChart ModelJson="@RateLimitTrendJson(dimensionName, points)" />
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <div class="text-xs text-slate-600">No rate-limit data observed yet</div>
                                }
                            </div>

                            @* Admin API key for provider cost reconciliation and reported usage
                               (docs/router/secrets-at-rest-plan.md §4/§7) - a distinct, more privileged
                               credential than the per-request inference key above. Optional: a Claude Pro/Max
                               or plain OpenAI account has no such key, and the rest of this card (and the
                               rest of the app) works fully without one. Only openai/anthropic are recognized,
                               matching BuildCostReconcilers/ManagementFacade.SetSecret. *@
                            @if (IsRecognizedReconciliationProvider(provider.Key))
                            {
                                <div>
                                    <div class="text-[10px] text-slate-600 uppercase tracking-wider mb-1">Admin API Key (cost reconciliation, optional)</div>
                                    @if (provider.HasStoredAdminKey)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-xs font-mono text-slate-400">•••••••• stored</span>
                                            <button @onclick="() => ClearAdminApiKey(provider.Key)" class="btn-small-action">Clear</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <input type="password"
                                                   value="@GetAdminKeyDraft(provider.Key)"
                                                   @oninput="e => _draftAdminKey[provider.Key] = AsString(e.Value)"
                                                   placeholder="sk-ant-admin01-… or Admin API key"
                                                   class="px-2 py-1 text-xs font-mono flex-1 min-w-0 ds-input" />
                                            <button @onclick="() => SaveAdminApiKey(provider.Key)" class="btn-small-action">Save</button>
                                        </div>
                                    }
                                </div>
                            }

                            @* Anthropic's own reported per-model daily token usage
                               (docs/router/secrets-at-rest-plan.md §8.1/§8.2), refreshed on the same hourly
                               cycle as cost reconciliation - never on card load, per Anthropic's caching
                               guidance. Anthropic-typed providers only: this is a Console/Enterprise Admin-key
                               feature, so an account without one (Claude Pro/Max) simply sees the empty state
                               below and nothing else on this card is affected. *@
                            @if (string.Equals(provider.ProviderType, "Anthropic", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mt-1">
                                    <div class="text-[10px] text-slate-600 uppercase tracking-wider mb-1">Reported Usage (Anthropic)</div>
                                    @if (provider.ReportedUsage is { Rows.Count: > 0 } reportedUsage)
                                    {
                                        <div class="ls-provider-budget-chart">
                                            <EChart ModelJson="@ReportedUsageJson(reportedUsage)" />
                                        </div>
                                        <div class="text-[10px] text-slate-600 mt-0.5">Fetched @FormatUtc(reportedUsage.FetchedAtUtc)</div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-600">No reported usage fetched yet</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_showDialog)
{
    <ProviderEditDialog Key="@_dialogKey"
                        IsNew="@_dialogIsNew"
                        BaseUrl="@_dialogBaseUrl"
                        AuthHeaderName="@_dialogAuthName"
                        Headers="@_dialogHeaders"
                        IsFree="@_dialogIsFree"
                        ProviderType="@_dialogProviderType"
                        ProviderName="@_dialogProviderName"
                        Error="@_dialogError"
                        OnSave="SaveDialog"
                        OnCancel="CancelDialog" />
}

@if (_removeKey is not null)
{
    <RemoveProviderDialog ProviderKey="@_removeKey"
                          ModelCount="@_removeModelCount"
                          OnConfirm="ConfirmRemove"
                          OnCancel="CancelRemove" />
}

@code {
    private readonly Dictionary<string, string> _draftName = [];
    private readonly Dictionary<string, string> _draftId = [];
    private readonly Dictionary<string, string> _draftDollarCap = [];
    private readonly Dictionary<string, string> _draftTokenCap = [];
    private readonly Dictionary<string, string> _draftAdminKey = [];
    // Which providers currently have the "Add model manually" pane expanded - absent/false is the default
    // (collapsed), matching every other per-provider draft dictionary's "missing key = default" shape.
    private readonly HashSet<string> _addModelPaneOpen = [];
    private string? _opError;

    // Non-null while the type-to-confirm removal dialog is open, holding the provider it targets.
    private string? _removeKey;
    private int _removeModelCount;

    private bool _showDialog;
    private bool _dialogIsNew;
    private string _dialogKey = string.Empty;
    private string _dialogBaseUrl = string.Empty;
    private string _dialogAuthName = "Authorization";
    private IReadOnlyList<ProviderHeaderView> _dialogHeaders = [];
    private bool _dialogIsFree;
    private string _dialogProviderType = "Other";
    private string _dialogProviderName = string.Empty;
    private string? _dialogError;

    // Providers whose rate-limit trend history has already been requested this session - loaded once per
    // provider rather than on every Store.Changed re-render, since the history endpoint is a separate
    // request from the provider list itself.
    private readonly HashSet<string> _historyRequested = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.LoadAsync();
        RequestRateLimitHistories();
    }

    // Store.Changed is raised from async continuations in ProviderAdminStore, not guaranteed to already be
    // on the Blazor renderer's sync context - RequestRateLimitHistories mutates _historyRequested (a plain,
    // non-thread-safe HashSet), so it has to run inside the same InvokeAsync as StateHasChanged rather than
    // directly on whatever thread raised the event.
    /// <summary>Re-requests rate-limit history for any newly-eligible providers and re-renders when the store's state changes.</summary>
    private void OnStoreChanged() =>
        InvokeAsync(() =>
        {
            RequestRateLimitHistories();
            StateHasChanged();
        });

    // Kicks off (fire-and-forget, best-effort) a history load for every provider that has a rate-limit
    // snapshot and hasn't been requested yet. LoadRateLimitHistoryAsync raises Store.Changed on success,
    // which re-enters this method - the HashSet guard is what stops that from looping.
    /// <summary>Starts a fire-and-forget rate-limit history load for every provider that has a snapshot and hasn't already been requested this session.</summary>
    private void RequestRateLimitHistories()
    {
        foreach (var provider in Store.Providers)
        {
            if (provider.RateLimit is null || !_historyRequested.Add(provider.Key))
            {
                continue;
            }

            _ = Store.LoadRateLimitHistoryAsync(provider.Key);
        }
    }

    /// <summary>Unsubscribes from <see cref="ProviderAdminStore.Changed"/>.</summary>
    public void Dispose() => Store.Changed -= OnStoreChanged;

    /// <summary>Clears the inline error and reloads providers. Implements the unreachable state's Retry button.</summary>
    private async Task Reload()
    {
        _opError = null;
        await Store.LoadAsync();
    }

    /// <summary>Opens the edit dialog seeded with blank/default fields for adding a new provider.</summary>
    private void OpenAdd()
    {
        _dialogIsNew = true;
        _dialogKey = string.Empty;
        _dialogBaseUrl = string.Empty;
        _dialogAuthName = "Authorization";
        _dialogHeaders = [];
        _dialogIsFree = false;
        _dialogProviderType = "Other";
        _dialogProviderName = string.Empty;
        _dialogError = null;
        _showDialog = true;
    }

    /// <summary>Opens the edit dialog seeded with an existing provider's current fields.</summary>
    private void OpenEdit(ProviderAdminView provider)
    {
        _dialogIsNew = false;
        _dialogKey = provider.Key;
        _dialogBaseUrl = provider.BaseUrl;
        _dialogAuthName = provider.AuthHeaderName;
        _dialogHeaders = provider.Headers;
        _dialogIsFree = provider.IsFree;
        // A provider stored before ProviderType existed has none; the dialog falls back to "Other" itself,
        // but pass through what is stored so an Anthropic provider reopens as Anthropic rather than
        // silently reverting to Other on every edit.
        _dialogProviderType = provider.ProviderType ?? "Other";
        _dialogProviderName = provider.Name ?? string.Empty;
        _dialogError = null;
        _showDialog = true;
    }

    /// <summary>Closes the edit dialog without saving.</summary>
    private void CancelDialog()
    {
        _showDialog = false;
        _dialogError = null;
    }

    /// <summary>Submits the edit dialog's result as an add or edit, closing the dialog on success or showing the rejection inline.</summary>
    private async Task SaveDialog(ProviderEditDialog.ProviderEditResult result)
    {
        var body = new ProviderWriteRequest(
            BaseUrl: result.BaseUrl,
            AuthHeaderName: result.AuthHeaderName,
            Headers: result.Headers,
            IsFree: result.IsFree,
            ProviderName: result.ProviderName,
            ProviderType: result.ProviderType);

        try
        {
            await Store.UpsertProviderAsync(result.Key, body);
            _showDialog = false;
            _dialogError = null;
        }
        catch (ProviderAdminException ex)
        {
            _dialogError = ex.Message;
        }
    }

    // Opens the type-to-confirm dialog rather than removing immediately: this is the sole delete entry
    // point and removal cascades to the provider's models, so the dialog states that consequence and
    // makes the user type the key (RemoveProviderDialog).
    private void RemoveProvider(ProviderAdminView provider)
    {
        _removeKey = provider.Key;
        _removeModelCount = provider.Models.Count;
    }

    /// <summary>Closes the type-to-confirm removal dialog without removing anything.</summary>
    private void CancelRemove()
    {
        _removeKey = null;
        _removeModelCount = 0;
    }

    /// <summary>Removes the provider the removal dialog targeted, after closing the dialog first.</summary>
    private async Task ConfirmRemove()
    {
        var key = _removeKey;
        if (key is null)
        {
            return;
        }

        // Close first so the dialog doesn't sit over the pane while the request is in flight, and so a
        // server-side rejection lands in the pane's error banner where every other failed operation does.
        CancelRemove();
        await RunAsync(() => Store.RemoveProviderAsync(key));
    }

    // Flips the provider's Enabled flag through the dedicated /enabled route, which preserves every other
    // configured field. The proxy's routing path (RequestInterceptor/ProxyMiddleware) skips a stopped
    // provider, so this takes effect on the next request.
    private async Task ToggleEnabled(ProviderAdminView provider)
    {
        await RunAsync(() => Store.SetEnabledAsync(provider.Key, new ProviderEnabledWriteRequest(!provider.Enabled)));
    }

    // The model-level twin of ToggleEnabled: flips a model's own Start/Stop state through the dedicated
    // /enabled route, independent of whether the last scan reported it present.
    /// <summary>Flips one model's own Start/Stop state.</summary>
    private async Task ToggleModelEnabled(ProviderAdminView provider, ModelAdminView model)
    {
        await RunAsync(() => Store.SetModelEnabledAsync(provider.Key, model.ModelName, new ModelEnabledWriteRequest(!model.Enabled)));
    }

    /// <summary>Removes one model from a provider.</summary>
    private async Task RemoveModel(string key, string modelName)
    {
        await RunAsync(() => Store.RemoveModelAsync(key, modelName));
    }

    /// <summary>The dialects the override dropdown offers, plus the "auto-detect" entry the markup adds.</summary>
    private static IReadOnlyList<string> ToolDialects => ToolCallDialectNames.All;

    // Pins how this model expresses tool calls, or - for an empty selection - clears the pin so automatic
    // detection resumes. Worth an operator control because automatic detection can reach a wrong answer that
    // never self-corrects: a model that emits native tool_calls on only some replies is recorded
    // openai-native on the first one that succeeds, and is then never re-inspected.
    /// <summary>Pins (or clears, for an empty selection) a model's tool-call dialect override.</summary>
    private async Task SetModelDialect(string key, string modelName, string? dialect)
    {
        await RunAsync(() => Store.SetModelToolDialectAsync(key, modelName, new ModelToolDialectWriteRequest(dialect)));
    }

    /// <summary>Whether a provider's "Add model manually" pane is currently expanded.</summary>
    private bool IsAddModelPaneOpen(string key) => _addModelPaneOpen.Contains(key);

    /// <summary>Expands or collapses a provider's "Add model manually" pane.</summary>
    private void ToggleAddModelPane(string key)
    {
        if (!_addModelPaneOpen.Remove(key))
        {
            _addModelPaneOpen.Add(key);
        }
    }

    /// <summary>Submits the manual add-model form's draft name/id, clearing the drafts on success.</summary>
    private async Task AddModel(string key)
    {
        var name = GetDraft(_draftName, key).Trim();
        if (string.IsNullOrEmpty(name))
        {
            return;
        }

        var id = GetDraft(_draftId, key).Trim();
        var body = new ModelWriteRequest(string.IsNullOrEmpty(id) ? null : id);
        if (await RunAsync(() => Store.UpsertModelAsync(key, name, body)))
        {
            _draftName[key] = string.Empty;
            _draftId[key] = string.Empty;
        }
    }

    // The router does all the work here (discovery, model-list reconciliation, endpoint-flavor scan,
    // dialect detection - see ManagementFacade.RefreshFromEndpointAsync); this just triggers it and
    // publishes the fresh result, same as every other mutation on this page.
    /// <summary>Triggers a live re-scan of a provider's endpoint: model discovery/reconciliation, API-flavor detection, and dialect detection.</summary>
    private async Task RefreshFromEndpoint(string key)
    {
        await RunAsync(() => Store.RefreshFromEndpointAsync(key));
    }

    /// <summary>The warning icon's tooltip text for a provider whose last admin interaction failed.</summary>
    private static string FailureTip(ProviderInteractionStatusAdminView failure) =>
        $"{failure.Operation} failed {FormatUtc(failure.AtUtc)}: {failure.Message}";

    /// <summary>The API-flavor badge labels a provider's last capability scan detected, if any.</summary>
    private static IEnumerable<string> DetectedApis(ProviderEndpointCapabilitiesView? capabilities)
    {
        if (capabilities is null)
        {
            yield break;
        }

        if (capabilities.AnthropicCompatible)
        {
            yield return "Anthropic";
        }

        if (capabilities.OpenAiCompatible)
        {
            yield return "OpenAI";
        }

        if (capabilities.LmStudioNative)
        {
            yield return "LM Studio";
        }

        if (capabilities.OllamaNative)
        {
            yield return "Ollama";
        }
    }

    /// <summary>Runs a mutation, surfacing a failure in the inline error banner rather than letting it escape into the renderer.</summary>
    private async Task<bool> RunAsync(Func<Task> operation)
    {
        _opError = null;
        try
        {
            await operation();
            return true;
        }
        catch (ProviderAdminException ex)
        {
            _opError = ex.Message;
            return false;
        }
    }

    /// <summary>The in-progress draft text for a per-provider input, or empty if none has been typed yet.</summary>
    private static string GetDraft(Dictionary<string, string> drafts, string key) =>
        drafts.TryGetValue(key, out var value) ? value : string.Empty;

    /// <summary>Coerces a Blazor event value to a non-null string.</summary>
    private static string AsString(object? value) => (string?)value ?? string.Empty;

    // A budget input shows the user's in-progress edit if there is one, otherwise the persisted value (so a
    // freshly loaded card reflects what's stored). A successful save clears the draft, letting the input
    // re-seed from the refreshed provider.
    /// <summary>The in-progress budget draft for a provider, or the persisted cap when there is no unsaved edit.</summary>
    private static string GetBudgetDraft(Dictionary<string, string> drafts, string key, string? current) =>
        drafts.TryGetValue(key, out var value) ? value : (current ?? string.Empty);

    // Percentage of a cap consumed, clamped to 0-100 for the bar height. A zero cap reads as 100% (fully
    // breached) to match the backend's spend >= cap rule - a "$0/month" provider is over budget the moment
    // it exists, so the bar must show CRITICAL, not an OK-looking 0%.
    /// <summary>The percentage of a dollar cap consumed, clamped to [0, 100].</summary>
    private static double UtilizationPercent(decimal spent, decimal cap) =>
        cap <= 0m ? 100d : (double)Math.Min(spent / cap * 100m, 100m);

    /// <summary>The percentage of a token cap consumed, clamped to [0, 100].</summary>
    private static double UtilizationPercent(long used, long cap) =>
        cap <= 0 ? 100d : Math.Min((double)used / cap * 100d, 100d);

    /// <summary>Formats a decimal amount with two fixed decimal places.</summary>
    private static string Money2(decimal value) => value.ToString("F2", CultureInfo.InvariantCulture);

    // OK / approaching / breached, matching the old Budgets view's 80% and 100% thresholds.
    /// <summary>The utilization bar's status color: green under 80%, amber under 100%, red at or above.</summary>
    private static string BarColor(double pct) =>
        pct >= 100d ? "#ef4444" : pct >= 80d ? "#f59e0b" : "#10b981";

    // A single-bar GroupedBars chart (0-100 y-axis) for one utilization dimension, colored by status. The
    // renderer ignores the model title, so the human-readable label lives in the surrounding markup.
    /// <summary>Serializes one budget-utilization bar's chart-model JSON.</summary>
    private static string BudgetBarJson(string label, double pct)
    {
        var value = (decimal)Math.Round(pct, 1);
        var model = new GroupedBarsModel(
            label,
            [label],
            100m,
            [new DistributionSeries("Utilized", BarColor(pct), [value])]);
        return ChartJson.Serialize(model);
    }

    // Backend-stored timestamps only, never the GUI clock (docs/router/anthropic-reported-usage-plan.md
    // Phase 3 test contract) - both footers below format a value the server already computed.
    /// <summary>Formats a UTC timestamp for display.</summary>
    private static string FormatUtc(DateTimeOffset value) => value.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);

    /// <summary>The estimated-usage footer's "last recorded" caption, or a placeholder when no usage has been recorded.</summary>
    private static string FormatLastRecorded(DateTimeOffset? lastRecordedAtUtc) =>
        lastRecordedAtUtc is { } value ? $"Last recorded {FormatUtc(value)}" : "No usage recorded yet";

    // "requests" -> "Requests", "input-tokens" -> "Input tokens" - readable labels for the standard
    // rate-limit family's dimension keys, which RateLimitSnapshotParser leaves as their raw header-segment
    // names since interpretation is a display concern, not a parsing one.
    /// <summary>Converts a raw rate-limit dimension key into a readable label.</summary>
    private static string DimensionLabel(string dimensionName) =>
        dimensionName[..1].ToUpperInvariant() + dimensionName[1..].Replace('-', ' ');

    /// <summary>Formats one rate-limit dimension's remaining/limit/reset line.</summary>
    private static string FormatDimension(string dimensionName, RateLimitDimensionAdminView dimension)
    {
        var remaining = dimension.Remaining?.ToString("N0", CultureInfo.InvariantCulture) ?? "?";
        var limit = dimension.Limit?.ToString("N0", CultureInfo.InvariantCulture) ?? "?";
        var reset = dimension.ResetAt is { } resetAt ? $" · resets {FormatUtc(resetAt)}" : string.Empty;
        return $"{DimensionLabel(dimensionName)}: {remaining} of {limit} remaining{reset}";
    }

    /// <summary>Formats one rate-limit window's status/reset line.</summary>
    private static string FormatWindow(string windowName, RateLimitWindowAdminView window)
    {
        var status = window.Status ?? "unknown";
        var reset = window.ResetAt is { } resetAt ? $" · resets {FormatUtc(resetAt)}" : string.Empty;
        return $"{windowName} window: {status}{reset}";
    }

    // "~19 min at current rate" / "~2h 5m at current rate" - no fabricated urgency: this only renders when
    // ManagementFacade has already decided a projection exists (RateLimitProjection.Project returned
    // non-null), so there is nothing to show when burn rate can't be trusted (flat, refilled, reset-before-empty).
    /// <summary>Formats a rate-limit exhaustion projection's estimated time-to-exhaustion caption.</summary>
    private static string FormatBurnRate(RateLimitExhaustionAdminView projection)
    {
        var eta = projection.TimeToExhaustion;
        var span = eta.TotalHours >= 1
            ? $"{(int)eta.TotalHours}h {eta.Minutes}m"
            : $"{Math.Max(1, (int)eta.TotalMinutes)} min";
        return $"~{span} at current rate";
    }

    // Cycled by model index rather than picked per model name, so the palette stays stable regardless of
    // how many distinct models a provider reports on a given day.
    private static readonly string[] ReportedUsageSeriesColors = ["#1ed760", "#10b981", "#38bdf8", "#a78bfa", "#f59e0b", "#f472b6"];

    /// <summary>Builds a daily-token-bars-grouped-by-model chart (docs/router/secrets-at-rest-plan.md §8.2): one category per reported day, one series per reported model.</summary>
    private static string ReportedUsageJson(ProviderReportedUsageAdminView usage)
    {
        var days = usage.Rows.Select(r => r.UsageDay).Distinct().OrderBy(d => d).ToList();
        var models = usage.Rows.Select(r => r.Model).Distinct().OrderBy(m => m, StringComparer.Ordinal).ToList();

        var series = models.Select((model, index) =>
        {
            var data = days.Select(day =>
            {
                var row = usage.Rows.FirstOrDefault(r => r.UsageDay == day && r.Model == model);
                return row is null
                    ? 0m
                    : (decimal)(row.InputTokens + row.OutputTokens + row.CacheCreationTokens + row.CacheReadTokens);
            }).ToList();
            return new DistributionSeries(model, ReportedUsageSeriesColors[index % ReportedUsageSeriesColors.Length], data);
        }).ToList();

        var model = new GroupedBarsModel(
            "Daily Token Usage",
            days.Select(d => d.ToString("MM-dd", CultureInfo.InvariantCulture)).ToList(),
            GroupedBarsModel.DynamicYMax(series.Select(s => s.Data)),
            series);
        return ChartJson.Serialize(model);
    }

    /// <summary>Serializes one rate-limit dimension's trend-chart-model JSON.</summary>
    private static string RateLimitTrendJson(string dimensionName, IReadOnlyList<RateLimitHistoryPointAdminView> points)
    {
        var model = RateLimitTrendChartBuilder.Build(
            dimensionName,
            points.Select(p => (p.BucketUtc, p.Remaining, p.Limit)).ToList());
        return ChartJson.Serialize(model);
    }

    /// <summary>Validates and submits the budget form's draft dollar/token caps, clearing the drafts on success.</summary>
    private async Task SaveBudget(string key)
    {
        _opError = null;

        var provider = Store.Providers.FirstOrDefault(p => string.Equals(p.Key, key, StringComparison.OrdinalIgnoreCase));

        var dollarText = _draftDollarCap.TryGetValue(key, out var d) ? d : provider?.DollarCap?.ToString(CultureInfo.InvariantCulture);
        var tokenText = _draftTokenCap.TryGetValue(key, out var t) ? t : provider?.TokenCap?.ToString(CultureInfo.InvariantCulture);

        if (!TryParseDecimalCap(dollarText, out var dollarCap))
        {
            _opError = "Monthly $ cap must be a non-negative number, or blank for no cap.";
            return;
        }

        if (!TryParseLongCap(tokenText, out var tokenCap))
        {
            _opError = "Monthly token cap must be a non-negative whole number, or blank for no cap.";
            return;
        }

        if (await RunAsync(() => Store.SetBudgetAsync(key, new ProviderBudgetWriteRequest(dollarCap, tokenCap))))
        {
            // Drop the drafts so the inputs re-seed from the persisted values the refreshed store now holds.
            _draftDollarCap.Remove(key);
            _draftTokenCap.Remove(key);
        }
    }

    // The only two providers BuildCostReconcilers/ManagementFacade.SetSecret recognize
    // (docs/router/agent-cost-tracking.md §3.5) - matches the provider dictionary key convention under
    // CostTracking:Reconciliation:Providers, not ProviderType.
    /// <summary>Whether a provider key is one of the two providers cost reconciliation recognizes.</summary>
    private static bool IsRecognizedReconciliationProvider(string key) =>
        string.Equals(key, "openai", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(key, "anthropic", StringComparison.OrdinalIgnoreCase);

    /// <summary>The in-progress draft text for a provider's Admin API key field, or empty if none has been typed yet.</summary>
    private string GetAdminKeyDraft(string key) => _draftAdminKey.TryGetValue(key, out var value) ? value : string.Empty;

    /// <summary>Validates and stores the draft Admin API key for a provider, clearing the draft on success.</summary>
    private async Task SaveAdminApiKey(string key)
    {
        _opError = null;

        var value = GetAdminKeyDraft(key);
        if (string.IsNullOrWhiteSpace(value))
        {
            _opError = "Admin API key must not be blank.";
            return;
        }

        if (await RunAsync(() => Store.SetAdminApiKeyAsync(key, value)))
        {
            _draftAdminKey.Remove(key);
        }
    }

    /// <summary>Clears a provider's stored Admin API key.</summary>
    private async Task ClearAdminApiKey(string key)
    {
        if (await RunAsync(() => Store.DeleteAdminApiKeyAsync(key)))
        {
            _draftAdminKey.Remove(key);
        }
    }

    // Parses an optional decimal cap: blank -> null (no cap); a non-negative number -> that value; anything
    // else -> rejected (caller shows the error). Mirrors TryParseLongCap for the token dimension.
    /// <summary>Parses an optional decimal budget cap: blank means no cap, a non-negative number is accepted, anything else is rejected.</summary>
    private static bool TryParseDecimalCap(string? text, out decimal? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        if (decimal.TryParse(text.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0m)
        {
            value = parsed;
            return true;
        }

        return false;
    }

    /// <summary>Parses an optional integer budget cap: blank means no cap, a non-negative whole number is accepted, anything else is rejected.</summary>
    private static bool TryParseLongCap(string? text, out long? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(text))
        {
            return true;
        }

        if (long.TryParse(text.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0)
        {
            value = parsed;
            return true;
        }

        return false;
    }
}
