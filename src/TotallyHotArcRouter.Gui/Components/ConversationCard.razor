@* One conversation (session) card in the Sessions tab. Single-click selects the card; double-click
   opens the split view with session details and conversation history. The data-tip spans inside
   this button are mouse-hover-only informational text (no tabindex): nesting a focusable element
   inside a <button> is an ARIA anti-pattern, so screen readers instead get the same facts via
   this button's aria-label; sighted keyboard users already see all the values as plain text. *@
<button @onclick="() => OnSelect.InvokeAsync(Conversation.Id)"
        @ondblclick="() => OnDoubleClick.InvokeAsync(Conversation.Id)"
        aria-label="@AriaLabel"
        aria-pressed="@IsSelected"
        class="w-full text-left rounded card-hover row-enter px-2.5 py-2 @(Conversation.HasFallbackTurns ? "card-fallback" : "") @(IsSelected ? "card-selected" : "card-unselected")"
        style="--i:@StaggerIndex">
    @* Title + fallback badge *@
    <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-slate-200 ls-truncate">@Conversation.Title</span>
        @if (Conversation.HasFallbackTurns)
        {
            <span class="ml-auto shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold ls-tip ds-badge-warning"
                  data-tip="One or more turns in this conversation used fallback routing">⚠</span>
        }
    </div>

    @* First → last turn timestamps *@
    <div class="text-xs font-mono text-slate-500 mb-1 ls-tip"
         data-tip="Timestamps of the first and last turn in this conversation">
        @Conversation.FirstTimestamp <span class="text-slate-600">→</span> @Conversation.LastTimestamp
    </div>

    @* Cost · tokens · turns *@
    <div class="flex items-center gap-2 text-xs font-mono">
        <span class="ls-tip metric-positive" data-tip="Total LLM API cost across all turns in this conversation">
            $@Conversation.TotalCost.ToString("F6", CultureInfo.InvariantCulture)
        </span>
        <span class="text-slate-600">·</span>
        <span class="text-slate-300 ls-tip" data-tip="Total prompt + completion tokens across all turns">
            @FormatTokens(Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens) tok
        </span>
        <span class="text-slate-600">·</span>
        <span class="text-slate-400 ls-tip" data-tip="Number of turns (multi-step agent workflows) in this conversation">
            @Conversation.Turns.Count @(Conversation.Turns.Count == 1 ? "turn" : "turns")
        </span>
    </div>

    @* Agent pool: color-dotted names for the first two distinct agents *@
    <div class="flex items-center gap-2 mt-1 text-xs text-slate-500 ls-truncate">
        @foreach (var agent in DistinctAgents.Take(2))
        {
            <span class="flex items-center gap-1 shrink-0">
                <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:@ColorUtils.GetColorForAgent(agent)"></span>
                @agent
            </span>
        }
        @if (DistinctAgents.Count > 2)
        {
            <span class="text-slate-600">+@(DistinctAgents.Count - 2)</span>
        }
    </div>
</button>

@code {
    /// <summary>The conversation this card summarizes.</summary>
    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    /// <summary>Whether this card is the currently selected conversation in the Sessions tab.</summary>
    [Parameter]
    public bool IsSelected { get; set; }

    /// <summary>Invoked with <see cref="Conversation"/>'s id when the card is single-clicked.</summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    /// <summary>Invoked with <see cref="Conversation"/>'s id when the card is double-clicked, opening the split-view session details and conversation history.</summary>
    [Parameter]
    public EventCallback<string> OnDoubleClick { get; set; }

    /// <summary>
    /// Per-item entrance delay index, multiplied by 30ms by the <c>.row-enter</c> rule
    /// (docs/gui/MOTION.md §7). Non-zero only while the list is first appearing; cards arriving
    /// later from the live stream pass 0 so they animate without delay.
    /// </summary>
    [Parameter]
    public int StaggerIndex { get; set; }

    /// <summary>The distinct agent names across this conversation's turns, in first-seen order.</summary>
    private List<string> DistinctAgents => Conversation.Turns.Select(t => t.Agent).Distinct().ToList();

    // Screen-reader equivalent of the card's visible data-tip spans (see the accessibility note in
    // the markup above for why those spans aren't independently focusable). The label also announces
    // that double-clicking opens the session details view, so keyboard/screen-reader users know the
    // gesture is available without needing to discover it visually.
    /// <summary>The card button's accessible label, restating every stat the visible data-tip spans convey and announcing the double-click action.</summary>
    private string AriaLabel =>
        $"{Conversation.Title}" +
        (Conversation.HasFallbackTurns ? ", fallback routing used" : string.Empty) +
        $". {Conversation.FirstTimestamp} to {Conversation.LastTimestamp}. " +
        $"Cost ${Conversation.TotalCost.ToString("F6", CultureInfo.InvariantCulture)}, " +
        $"{FormatTokens(Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens)} tokens, " +
        $"{Conversation.Turns.Count} {(Conversation.Turns.Count == 1 ? "turn" : "turns")}. " +
        "Double-click to open session details and conversation history.";

    /// <summary>Abbreviates a token count for compact display: "1.2M", "830.0K", or the bare number under 1,000.</summary>
    private static string FormatTokens(int tokens) => tokens switch
    {
        >= 1_000_000 => (tokens / 1_000_000.0).ToString("F1", CultureInfo.InvariantCulture) + "M",
        >= 1_000 => (tokens / 1_000.0).ToString("F1", CultureInfo.InvariantCulture) + "K",
        _ => tokens.ToString(CultureInfo.InvariantCulture),
    };
}
