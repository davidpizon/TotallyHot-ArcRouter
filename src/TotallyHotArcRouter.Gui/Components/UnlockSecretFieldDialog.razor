@* Confirms clearing a locked SecretField value before unlocking it. A locked value was never sent
   to this screen, so unlocking always means clearing and re-entering it - this dialog states that
   consequence before the click. Smaller-blast-radius sibling of RemoveProviderDialog: a single field,
   not a whole provider, so Continue/Cancel is enough - no type-to-confirm. Follows SettingsModal shell
   (docs/gui/DESIGN.md 4.1). *@
<div class="overlay-backdrop fixed inset-0 z-50 flex items-center justify-center"
     @onclick="OnCancel">
    <div class="overlay-panel w-full max-w-md rounded-lg border border-slate-700"
         tabindex="-1"
         @onkeydown="HandlePanelKeyDown"
         @onclick:stopPropagation="true">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700">
            <span class="text-sm font-semibold text-slate-200 tracking-wide uppercase">Unlock Value</span>
            <button @onclick="OnCancel"
                    aria-label="Close unlock value dialog"
                    class="text-slate-400 hover:text-slate-200 transition-colors">
                <Icon Name="x" Size="20" />
            </button>
        </div>

        <div class="overlay-content p-5 space-y-4">
            <div class="flex items-center gap-2 text-xs text-amber-400 font-medium uppercase tracking-widest">
                <Icon Name="alert-triangle" Size="20" />
                <span>Destructive Action</span>
            </div>

            <div class="space-y-3 ds-destructive-box">
                <p class="text-xs text-slate-400 leading-5">
                    This value is <span class="text-red-400 font-semibold">locked and was never sent to
                    this screen</span>, so unlocking it will clear it entirely. You will need to retype it.
                </p>
                <div class="flex gap-2">
                    <button @ref="_cancelButton"
                            @onclick="OnCancel"
                            data-testid="@(TestId is { Length: > 0 } id ? $"{id}-cancel" : null)"
                            class="flex-1 btn btn-ghost">
                        Cancel
                    </button>
                    <button @onclick="OnConfirm"
                            data-testid="@(TestId is { Length: > 0 } continueId ? $"{continueId}-continue" : null)"
                            class="flex-1 btn btn-critical">
                        Continue
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Optional test-id prefix; the Cancel and Continue buttons get it suffixed
    /// <c>-cancel</c> / <c>-continue</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Invoked when the user confirms - the caller clears the value and unlocks.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Invoked when the modal should close without unlocking - backdrop, the X, Cancel, or Escape.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private ElementReference _cancelButton;
    private bool _focusPending = true;

    // Bound on the panel so Escape closes the dialog regardless of which control has focus - keydown
    // bubbles up from every focusable descendant.
    /// <summary>Closes the dialog when Escape is pressed anywhere within the panel.</summary>
    private async Task HandlePanelKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await OnCancel.InvokeAsync();
        }
    }

    // Focus starts on the padlock that opened the dialog, so Escape wouldn't otherwise reach the
    // panel's keydown handler until the user tabs into it. Cancel gets initial focus (not Continue)
    // since it is the non-destructive default.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            await _cancelButton.FocusAsync();
        }
    }
}
