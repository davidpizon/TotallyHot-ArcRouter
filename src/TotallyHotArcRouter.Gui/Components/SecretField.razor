@* A text field whose value the operator can choose to make secret. Unlocked (the default) it is an
   ordinary readable text box; locked it masks to dots and the router stops returning its value to this
   GUI at all, which is why unlocking has to clear it. The lock state is form data - it is reported
   through LockedChanged and saved with the rest of the form, never owned by this component.
   Full contract: docs/gui/secret-field.md. *@
<div class="ds-secret-field @Class">
    <input type="@(Locked ? "password" : "text")"
           value="@Value"
           @oninput="OnValueInput"
           disabled="@Disabled"
           placeholder="@Placeholder"
           data-testid="@TestId"
           class="px-2 py-1 text-xs font-mono ds-input ds-secret-input" />
    @* The padlock is a button, not a checkbox: locking and unlocking are asymmetric (one is
       destructive). Locking toggles immediately; unlocking opens a confirmation dialog instead of
       toggling in place. *@
    <button type="button"
            @onclick="OnToggleClick"
            disabled="@Disabled"
            data-tip="@Tip"
            aria-label="@(Locked ? "Unlock this value" : "Lock this value")"
            aria-describedby="ls-tooltip"
            data-testid="@ToggleTestId"
            class="ds-secret-toggle @ToggleStateClass">
        <Icon Name="@(Locked ? "lock" : "unlock")" Size="20" />
    </button>
</div>
@if (_confirmingUnlock)
{
    <UnlockSecretFieldDialog TestId="@TestId" OnConfirm="ConfirmUnlock" OnCancel="CancelUnlock" />
}

@code {
    /// <summary>Tooltip shown on an unlocked field, explaining what locking costs.</summary>
    public const string UnlockedTip = "Lock this value. A locked value is shown as dots and is never sent back to this screen.";

    /// <summary>Tooltip shown on a locked field. States the consequence before the click, not after.</summary>
    public const string LockedTip = "Locked - this value cannot be read. Unlocking it will clear the value entirely.";

    /// <summary>Whether the unlock confirmation dialog is open.</summary>
    private bool _confirmingUnlock;

    /// <summary>The field's text. Blank on a locked field means "keep whatever is stored".</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Raised when the user edits the text, or when unlocking clears it.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Whether the value is a secret: masked here, and withheld by the router on the next read.</summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary>Raised when the padlock is toggled. The parent owns the state; this component only asks.</summary>
    [Parameter]
    public EventCallback<bool> LockedChanged { get; set; }

    /// <summary>Greyed hint shown when the field is empty.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Extra CSS classes for the wrapper, e.g. flex sizing supplied by the surrounding row.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>The input's <c>data-testid</c>; the padlock gets the same value suffixed with <c>-lock</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Whether the field and its padlock are non-interactive.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The padlock's test id, kept in step with <see cref="TestId"/> so tests locate both from one name.</summary>
    private string? ToggleTestId => TestId is { Length: > 0 } id ? $"{id}-lock" : null;

    /// <summary>The tooltip for the current state.</summary>
    private string Tip => Locked ? LockedTip : UnlockedTip;

    /// <summary>The padlock's state color class (see <c>.ds-secret-toggle-*</c> in app.css).</summary>
    private string ToggleStateClass => Locked ? "ds-secret-toggle-locked" : "ds-secret-toggle-unlocked";

    /// <summary>Propagates a typed edit to <see cref="ValueChanged"/>.</summary>
    private Task OnValueInput(ChangeEventArgs e)
    {
        Value = (string?)e.Value ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }

    /// <summary>
    /// Locks in one click (nothing is lost, the typed value simply becomes a secret). Unlocking opens a
    /// confirmation dialog instead of toggling immediately - the clear is not optional, since a locked
    /// value was never returned to this screen, so it needs an explicit, unmissable step rather than a
    /// second click on the same tiny control.
    /// </summary>
    private async Task OnToggleClick()
    {
        if (!Locked)
        {
            Locked = true;
            await LockedChanged.InvokeAsync(true);
            return;
        }

        _confirmingUnlock = true;
    }

    /// <summary>Clears the value, unlocks, and closes the confirmation dialog.</summary>
    private async Task ConfirmUnlock()
    {
        _confirmingUnlock = false;
        Locked = false;
        Value = string.Empty;
        await ValueChanged.InvokeAsync(string.Empty);
        await LockedChanged.InvokeAsync(false);
    }

    /// <summary>Closes the confirmation dialog without changing lock state or value.</summary>
    private void CancelUnlock() => _confirmingUnlock = false;
}
