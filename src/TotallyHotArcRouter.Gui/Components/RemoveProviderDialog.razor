@* Type-to-confirm removal dialog for a provider (the Governance > Providers trashcan). Removal
   cascades to the provider's models, so the consequence is spelled out before the user commits -
   the same safeguard GitHub uses for deleting a repository. Follows SettingsModal's shell
   (docs/gui/DESIGN.md 4.1) and its "Destructive Actions Zone" body treatment. *@
<DialogShell Title="Remove Provider" CloseAriaLabel="Close remove provider dialog" OnClose="OnCancel" EnableEscapeToClose="true">
    @* Destructive zone label - matches SettingsModal's. *@
    <div class="flex items-center gap-2 text-xs text-amber-400 font-medium uppercase tracking-widest">
        <Icon Name="alert-triangle" Size="20"/>
        <span>Destructive Action</span>
    </div>

    <div class="space-y-3 ds-destructive-box">
        <p class="text-xs text-slate-400 leading-5">
            This action is <span class="text-red-400 font-semibold">irreversible</span>.
            @if (ModelCount > 0)
            {
                <span>
                    It will also remove
                    <span class="text-slate-200 font-semibold">@ModelCount</span>
                    configured @(ModelCount == 1 ? "model" : "models").
                </span>
            }
            <span class="text-slate-500">Historical metrics are kept.</span>
        </p>
        <p class="text-xs text-slate-400 leading-5">
            Type
            <span class="font-mono text-slate-200 bg-slate-700 px-1.5 py-0.5 rounded text-xs">@ProviderKey</span>
            to confirm.
        </p>
        <input @ref="_confirmInput"
               type="text"
               value="@_confirmText"
               @oninput="e => _confirmText = (string?)e.Value ?? string.Empty"
               @onkeydown="HandleInputKeyDown"
               placeholder="Type @(ProviderKey)..."
               autocomplete="off"
               aria-label="@($"Type {ProviderKey} to confirm removal")"
               class="w-full px-3 py-2 text-sm font-mono ds-input"/>
        <div class="flex gap-2">
            <button @onclick="OnCancel"
                    class="flex-1 btn btn-ghost">
                Cancel
            </button>
            <button @onclick="Confirm"
                    disabled="@(!IsConfirmed)"
                    class="flex-1 btn btn-critical">
                Remove
            </button>
        </div>
    </div>
</DialogShell>

@code {

    /// <summary>The key of the provider being removed - also the word the user must type to confirm.</summary>
    [Parameter]
    public string ProviderKey { get; set; } = string.Empty;

    /// <summary>How many configured models will be removed along with the provider; suppressed from the warning when zero.</summary>
    [Parameter]
    public int ModelCount { get; set; }

    /// <summary>Invoked when the user confirms - the caller performs the actual removal.</summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>Invoked when the modal should close without removing - the backdrop, the X, Cancel, or Escape.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string _confirmText = string.Empty;
    private ElementReference _confirmInput;
    private bool _focusPending = true;

    // Case-sensitive on purpose: provider keys are matched case-insensitively everywhere else, but a
    // confirmation the user can satisfy with a near-miss isn't much of a confirmation.
    /// <summary>Whether the typed confirmation text exactly (case-sensitively) matches <see cref="ProviderKey"/>.</summary>
    private bool IsConfirmed => string.Equals(a: _confirmText, b: ProviderKey, comparisonType: StringComparison.Ordinal);

    /// <summary>Invokes <see cref="OnConfirm"/> once the confirmation text matches.</summary>
    private async Task Confirm()
    {
        if (!IsConfirmed)
        {
            return;
        }

        await OnConfirm.InvokeAsync();
    }

    // Enter confirms only while typing in the confirmation field, matching the muscle memory of
    // submitting a form. Escape is handled by DialogShell (EnableEscapeToClose="true"), bound on its
    // panel so it works regardless of which control has focus - not handled here, so one keypress can't
    // confirm twice as it bubbles past both handlers.
    /// <summary>Confirms removal when Enter is pressed in the confirmation input.</summary>
    private async Task HandleInputKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await Confirm();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            await _confirmInput.FocusAsync();
        }
    }

}