@* Governance > Benchmark Data pane: shows the CodeRouterBench corpus's freshness relative to the
   published Hugging Face dataset and lets the operator sync it on demand.
   Talks to the proxy's BenchmarkDataAdminService gRPC API via the injected BenchmarkDataStore.

   No licensing constraint applies here (unlike Price Sources/D5) - the corpus is public benchmark data -
   so file names, sizes, and row counts are shown freely. *@
@implements IDisposable
@inject BenchmarkDataStore Store
@inject LlmRouterModelStore VoterStore

<div class="h-full overflow-y-auto pr-1">
    @if (!Store.IsLoaded)
    {
        <div class="text-sm text-slate-500 p-4">Loading benchmark data status…</div>
    }
    else if (!Store.IsReachable)
    {
        <div class="rounded-lg p-4 space-y-2 ds-surface-card-critical">
            <div class="flex items-center gap-2 text-sm text-red-400 font-semibold">
                <Icon Name="alert-triangle" Size="14" /> Router unreachable
            </div>
            @* The store's own endpoint, not the default constant: naming an address the client was never
               pointed at is worse than naming none while diagnosing a connectivity failure. *@
            <div class="text-xs text-slate-400">
                @if (Store.ServerAddress is { Length: > 0 } serverAddress)
                {
                    <text>Could not reach <span class="font-mono">@serverAddress</span>. Is the proxy running?</text>
                }
                else
                {
                    <text>Could not reach the router. Is the proxy running?</text>
                }
            </div>
            @if (!string.IsNullOrEmpty(Store.LastError))
            {
                <div class="text-xs text-slate-500 font-mono">@Store.LastError</div>
            }
            <button @onclick="Reload" class="btn btn-ghost">
                Retry
            </button>
        </div>
    }
    else
    {
        @* Store.LastError covers a status load the router answered with a rejection: reachable, so the
           layout above stays, but the reason still has to be shown somewhere. *@
        @if (ErrorMessage() is { Length: > 0 } errorMessage)
        {
            <div class="mb-3 text-xs ds-alert-critical">
                @errorMessage
            </div>
        }

        @if (Store.Status is { } status)
        {
            @if (status.State == BenchmarkDataAdminState.CheckFailed && !string.IsNullOrEmpty(status.Reason))
            {
                <div class="mb-3 text-xs ds-alert-critical">
                    Could not check for updates: @status.Reason
                </div>
            }

            @* The corpus's .csv/.jsonl/.json files (BenchmarkFileSpec.All) are one logical asset, not eight -
               a single card represents them, with the per-file breakdown tucked behind a disclosure. *@
            <div class="rounded-lg p-3 space-y-2 ds-surface-card-draggable @(status.State == BenchmarkDataAdminState.Current ? "" : "ds-source-border-dim")">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-sm font-semibold @(status.State == BenchmarkDataAdminState.Current ? "state-enabled" : "state-disabled")">
                        Task Matrix
                    </span>
                    <button @onclick="RunAction"
                            disabled="@Store.IsSyncing"
                            title="@(status.Reason)"
                            class="btn btn-secondary flex items-center gap-1.5">
                        <Icon Name="rotate-ccw" Size="13" />
                        @ActionLabel()
                    </button>
                </div>

                <div class="text-xs text-slate-500">@SummaryLine(status)</div>

                @if (Store.IsSyncing)
                {
                    <div class="space-y-1.5">
                        <div>
                            <div class="flex items-center justify-between text-xs text-slate-500 mb-0.5">
                                <span>Overall progress</span>
                                <span class="font-mono">@CumulativeByteLabel()</span>
                            </div>
                            <div class="progress-bar-track" role="progressbar" aria-label="Overall Task Matrix update progress"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@CumulativePercent()">
                                <div class="progress-bar-fill" style="width:@(PercentCss(CumulativePercent()))%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-xs text-slate-500 mb-0.5">
                                <span class="font-mono truncate">@(Store.CurrentFileName ?? "Preparing…")</span>
                                <span class="font-mono">@CurrentFileByteLabel()</span>
                            </div>
                            <div class="progress-bar-track" role="progressbar" aria-label="@($"{Store.CurrentFileName ?? "Current file"} download progress")"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@CurrentFilePercent()">
                                <div class="progress-bar-fill" style="width:@(PercentCss(CurrentFilePercent()))%"></div>
                            </div>
                        </div>
                    </div>
                }

                <button @onclick="() => _filesExpanded = !_filesExpanded"
                        aria-expanded="@(_filesExpanded ? "true" : "false")"
                        class="flex items-center gap-1 text-xs text-slate-500 hover:text-slate-300 transition-colors">
                    <Icon Name="@(_filesExpanded ? "chevron-up" : "chevron-down")" Size="12" />
                    @(_filesExpanded ? "Hide files" : $"Show {status.Files.Count} files")
                </button>

                @* Rendered unconditionally, unlike the @if this replaced: collapsing can only
                   animate if the node survives the toggle. `inert` keeps the hidden rows out of
                   the tab order and the accessibility tree while the track is closed. *@
                <div class="ls-disclosure @(_filesExpanded ? "open" : null)" inert="@(!_filesExpanded)">
                    <div>
                        <div class="space-y-2 pt-1">
                            @foreach (var file in status.Files)
                            {
                                var progress = Store.SyncProgress.GetValueOrDefault(file.FileName);

                                <div @key="file.FileName" class="space-y-0.5">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-xs font-mono @(file.Synced ? "state-enabled" : "state-disabled")">
                                            @file.FileName
                                        </span>
                                        <span class="text-xs @StageClass(progress)">@StageLabel(file, progress)</span>
                                    </div>
                                    <div class="flex items-center justify-between text-xs text-slate-500">
                                        <span>@DescribeSize(file, progress)</span>
                                        <span>@DescribeSyncedAt(file)</span>
                                    </div>
                                    @if (progress is { Stage: BenchmarkSyncStageInfo.Failed, Error: { } error })
                                    {
                                        <div class="rounded px-2 py-1.5 text-xs ds-outcome-critical">
                                            <span class="flex items-center gap-1.5 text-red-300">
                                                <span aria-hidden="true"><Icon Name="alert-triangle" Size="12" /></span> @error
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Local Voter Model: the llm_router ONNX voter's 5 files (LlmRouterModelFiles.All). Same
           one-card-per-asset shape as Task Matrix above - a single card, two progress bars while
           syncing, and the per-file breakdown behind a disclosure. The base URL is a fixed pin (set via
           the override file/config, not this panel), so there is no URL editor here. *@
        <div class="ds-card-gap">
            @if (!VoterStore.IsLoaded)
            {
                <div class="text-sm text-slate-500 p-4">Loading local voter model status…</div>
            }
            else if (!VoterStore.IsReachable)
            {
                <div class="rounded-lg p-4 space-y-2 ds-surface-card-critical">
                    <div class="flex items-center gap-2 text-sm text-red-400 font-semibold">
                        <Icon Name="alert-triangle" Size="14" /> Router unreachable
                    </div>
                    <div class="text-xs text-slate-400">
                        @if (VoterStore.ServerAddress is { Length: > 0 } voterServerAddress)
                        {
                            <text>Could not reach <span class="font-mono">@voterServerAddress</span>. Is the proxy running?</text>
                        }
                        else
                        {
                            <text>Could not reach the router. Is the proxy running?</text>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(VoterStore.LastError))
                    {
                        <div class="text-xs text-slate-500 font-mono">@VoterStore.LastError</div>
                    }
                    <button @onclick="VoterReload" class="btn btn-ghost">
                        Retry
                    </button>
                </div>
            }
            else
            {
                @if (VoterErrorMessage() is { Length: > 0 } voterErrorMessage)
                {
                    <div class="mb-3 text-xs ds-alert-critical">
                        @voterErrorMessage
                    </div>
                }

                @if (VoterStore.Status is { } voterStatus)
                {
                    @* The voter's 5 files are one logical asset, not five - a single card represents
                       them, with the per-file breakdown tucked behind a disclosure, mirroring Task Matrix. *@
                    <div class="rounded-lg p-3 space-y-2 ds-surface-card-draggable @(voterStatus.Current ? "" : "ds-source-border-dim")">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm font-semibold @(voterStatus.Current ? "state-enabled" : "state-disabled")">
                                Local Voter Model
                            </span>
                            <button @onclick="RunVoterAction"
                                    disabled="@VoterStore.IsSyncing"
                                    class="btn btn-secondary flex items-center gap-1.5">
                                <Icon Name="rotate-ccw" Size="13" />
                                @VoterActionLabel()
                            </button>
                        </div>

                        <div class="text-xs text-slate-500 space-y-0.5">
                            <div>@VoterSummaryLine(voterStatus)</div>
                            <div class="font-mono truncate">@voterStatus.BaseUrl</div>
                        </div>

                        @if (VoterStore.IsSyncing)
                        {
                            <div class="space-y-1.5">
                                <div>
                                    <div class="flex items-center justify-between text-xs text-slate-500 mb-0.5">
                                        <span>Overall progress</span>
                                        <span class="font-mono">@VoterCumulativeByteLabel()</span>
                                    </div>
                                    <div class="progress-bar-track" role="progressbar" aria-label="Overall Local Voter Model update progress"
                                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@VoterCumulativePercent()">
                                        <div class="progress-bar-fill" style="width:@(PercentCss(VoterCumulativePercent()))%"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-center justify-between text-xs text-slate-500 mb-0.5">
                                        <span class="font-mono truncate">@(VoterStore.CurrentFileName ?? "Preparing…")</span>
                                        <span class="font-mono">@VoterCurrentFileByteLabel()</span>
                                    </div>
                                    <div class="progress-bar-track" role="progressbar" aria-label="@($"{VoterStore.CurrentFileName ?? "Current file"} download progress")"
                                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@VoterCurrentFilePercent()">
                                        <div class="progress-bar-fill" style="width:@(PercentCss(VoterCurrentFilePercent()))%"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <button @onclick="() => _voterFilesExpanded = !_voterFilesExpanded"
                                aria-expanded="@(_voterFilesExpanded ? "true" : "false")"
                                class="flex items-center gap-1 text-xs text-slate-500 hover:text-slate-300 transition-colors">
                            <Icon Name="@(_voterFilesExpanded ? "chevron-up" : "chevron-down")" Size="12" />
                            @(_voterFilesExpanded ? "Hide files" : $"Show {voterStatus.Files.Count} files")
                        </button>

                        @* Same always-mounted disclosure as Task Matrix above — see its comment. *@
                        <div class="ls-disclosure @(_voterFilesExpanded ? "open" : null)" inert="@(!_voterFilesExpanded)">
                            <div>
                                <div class="space-y-2 pt-1">
                                    @foreach (var file in voterStatus.Files)
                                    {
                                        var progress = VoterStore.SyncProgress.GetValueOrDefault(file.FileName);

                                        <div @key="file.FileName" class="space-y-0.5">
                                            <div class="flex items-center justify-between gap-2">
                                                <span class="text-xs font-mono @(file.Synced ? "state-enabled" : "state-disabled")">
                                                    @file.FileName
                                                </span>
                                                <span class="text-xs @VoterStageClass(progress)">@VoterStageLabel(file, progress)</span>
                                            </div>
                                            <div class="flex items-center justify-between text-xs text-slate-500">
                                                <span>@VoterDescribeSize(file, progress)</span>
                                                <span>@VoterDescribeSyncedAt(file)</span>
                                            </div>
                                            @if (file.Synced)
                                            {
                                                <div class="text-xs @(file.ChecksumVerified ? "text-emerald-400" : "text-slate-500")">
                                                    @(file.ChecksumVerified ? "Verified" : "Unverified")
                                                </div>
                                            }
                                            @if (progress is { Stage: LlmRouterModelSyncStageInfo.Failed, Error: { } voterError })
                                            {
                                                <div class="rounded px-2 py-1.5 text-xs ds-outcome-critical">
                                                    <span class="flex items-center gap-1.5 text-red-300">
                                                        <span aria-hidden="true"><Icon Name="alert-triangle" Size="12" /></span> @voterError
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private string? _opError;
    private string? _voterOpError;

    /// <summary>Whether the Task Matrix card's per-file disclosure is open. Starts collapsed.</summary>
    private bool _filesExpanded;

    /// <summary>Whether the Local Voter Model card's per-file disclosure is open. Starts collapsed.</summary>
    private bool _voterFilesExpanded;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        VoterStore.Changed += OnVoterStoreChanged;
        await Store.LoadAsync();
        await VoterStore.LoadAsync();
    }

    /// <summary>Re-renders when the corpus store's state changes.</summary>
    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Re-renders when the Local Voter Model store's state changes.</summary>
    private void OnVoterStoreChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The inline banner's text: the last mutation's rejection if there is one, otherwise the last load's.
    /// Both are cleared by the next successful call, so a stale message never outlives the failure.
    /// </summary>
    private string? ErrorMessage() => _opError ?? Store.LastError;

    /// <summary>Same convention as <see cref="ErrorMessage"/>, for the Local Voter Model section's own store.</summary>
    private string? VoterErrorMessage() => _voterOpError ?? VoterStore.LastError;

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        VoterStore.Changed -= OnVoterStoreChanged;
    }

    /// <summary>Clears the inline error and reloads the corpus status. Implements the unreachable state's Retry button.</summary>
    private async Task Reload()
    {
        _opError = null;
        await Store.LoadAsync();
    }

    /// <summary>Same purpose as <see cref="Reload"/>, for the Local Voter Model section's own store.</summary>
    private async Task VoterReload()
    {
        _voterOpError = null;
        await VoterStore.LoadAsync();
    }

    /// <summary>
    /// The header button's label, reflecting the corpus's freshness state directly - "Re-verify" once
    /// every file matches the published tree (the button stays enabled in this state, mirroring the Local
    /// Voter Model panel's <see cref="VoterActionLabel"/>: re-running the sync is the only way to confirm
    /// the ledger's recorded checksums still match what's actually on disk), "Update" when at least one
    /// file does not match, "Check Failed" when the last probe could not reach Hugging Face - and
    /// "Updating…" for the duration of a sync.
    /// </summary>
    private string ActionLabel()
    {
        if (Store.IsSyncing)
        {
            return "Updating…";
        }

        return Store.Status?.State switch
        {
            BenchmarkDataAdminState.Current => "Re-verify",
            BenchmarkDataAdminState.Update => "Update",
            BenchmarkDataAdminState.CheckFailed => "Check Failed",
            _ => "Check Failed",
        };
    }

    /// <summary>
    /// Runs the action the header button's current state implies: a stale corpus (Update) or an
    /// already-current one (Current, i.e. "Re-verify") both sync - the sync itself re-probes Hugging Face
    /// and only re-downloads files whose ledger checksum no longer matches, so re-verifying a current
    /// corpus is cheap. An unknown freshness (CheckFailed, or no status yet) rechecks rather than
    /// downloading blind.
    /// </summary>
    private Task RunAction() =>
        Store.Status?.State is BenchmarkDataAdminState.Update or BenchmarkDataAdminState.Current
            ? RunAsync(() => Store.SyncAsync())
            : RunAsync(() => Store.RecheckAsync());

    /// <summary>
    /// The Task Matrix card's at-rest summary line: how many files are synced, their combined size and
    /// row count, and the most recent sync time - the aggregate view that replaces the eight individual
    /// file cards this section used to show.
    /// </summary>
    private static string SummaryLine(BenchmarkDataStatusInfo status)
    {
        var syncedCount = status.Files.Count(f => f.Synced);
        var totalMb = status.Files.Sum(f => f.SizeBytes) / 1024.0 / 1024.0;
        var totalRows = status.Files.Sum(f => f.RowCount);

        if (syncedCount == 0)
        {
            return $"0 of {status.Files.Count} files synced";
        }

        var syncedAt = status.Files
            .Where(f => f.SyncedAtUtc is not null)
            .Select(f => f.SyncedAtUtc!.Value)
            .DefaultIfEmpty()
            .Max();

        return $"{syncedCount} of {status.Files.Count} files synced — {totalMb:0.#} MB, {totalRows:N0} rows — last synced {syncedAt.ToLocalTime():g} local";
    }

    /// <summary>The cumulative progress bar's byte counter label, e.g. "4.2 / 11.8 MB".</summary>
    private string CumulativeByteLabel() =>
        $"{Store.CumulativeBytesTransferred / 1024.0 / 1024.0:0.#} / {Store.CumulativeTotalBytes / 1024.0 / 1024.0:0.#} MB";

    /// <summary>
    /// Formats a fill percentage for a CSS <c>width</c> value using invariant culture, so a locale with a
    /// comma decimal separator (e.g. fr-FR) cannot turn <c>width:52.5%</c> into the invalid CSS
    /// <c>width:52,5%</c>.
    /// </summary>
    private static string PercentCss(double percent) => percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>The cumulative progress bar's fill percentage, 0-100.</summary>
    private double CumulativePercent() => Store.CumulativeTotalBytes > 0
        ? Math.Clamp(100.0 * Store.CumulativeBytesTransferred / Store.CumulativeTotalBytes, 0, 100)
        : 0;

    /// <summary>The current-file progress bar's byte counter label, e.g. "1.1 / 3.4 MB".</summary>
    private string CurrentFileByteLabel()
    {
        var progress = Store.CurrentFileName is { } fileName ? Store.SyncProgress.GetValueOrDefault(fileName) : null;
        var totalBytes = progress?.TotalBytes ?? 0;
        var transferred = progress?.BytesTransferred ?? 0;
        return $"{transferred / 1024.0 / 1024.0:0.#} / {totalBytes / 1024.0 / 1024.0:0.#} MB";
    }

    /// <summary>The current-file progress bar's fill percentage, 0-100.</summary>
    private double CurrentFilePercent()
    {
        var progress = Store.CurrentFileName is { } fileName ? Store.SyncProgress.GetValueOrDefault(fileName) : null;
        if (progress is not { TotalBytes: > 0 } || progress.BytesTransferred is not { } transferred)
        {
            return progress?.Stage is BenchmarkSyncStageInfo.Verifying or BenchmarkSyncStageInfo.Importing or BenchmarkSyncStageInfo.Completed
                ? 100
                : 0;
        }

        return Math.Clamp(100.0 * transferred / progress.TotalBytes.Value, 0, 100);
    }

    /// <summary>
    /// The Local Voter Model card's at-rest summary line: how many of the 5 files are synced, their
    /// combined size, how many are checksum-verified, and the most recent sync time - the aggregate view
    /// that replaces the five individual file cards this section used to show, mirroring
    /// <see cref="SummaryLine"/>.
    /// </summary>
    private static string VoterSummaryLine(LlmRouterModelStatusInfo status)
    {
        var syncedCount = status.Files.Count(f => f.Synced);
        var totalMb = status.Files.Sum(f => f.SizeBytes) / 1024.0 / 1024.0;
        var verifiedCount = status.Files.Count(f => f.ChecksumVerified);

        if (syncedCount == 0)
        {
            return $"0 of {status.Files.Count} files synced";
        }

        var syncedAt = status.Files
            .Where(f => f.SyncedAtUtc is not null)
            .Select(f => f.SyncedAtUtc!.Value)
            .DefaultIfEmpty()
            .Max();

        return $"{syncedCount} of {status.Files.Count} files synced — {totalMb:0.#} MB, {verifiedCount} verified — last synced {syncedAt.ToLocalTime():g} local";
    }

    /// <summary>The Local Voter Model cumulative progress bar's byte counter label, e.g. "4.2 / 11.8 MB".</summary>
    private string VoterCumulativeByteLabel() =>
        $"{VoterStore.CumulativeBytesTransferred / 1024.0 / 1024.0:0.#} / {VoterStore.CumulativeTotalBytes / 1024.0 / 1024.0:0.#} MB";

    /// <summary>The Local Voter Model cumulative progress bar's fill percentage, 0-100.</summary>
    private double VoterCumulativePercent() => VoterStore.CumulativeTotalBytes > 0
        ? Math.Clamp(100.0 * VoterStore.CumulativeBytesTransferred / VoterStore.CumulativeTotalBytes, 0, 100)
        : 0;

    /// <summary>The Local Voter Model current-file progress bar's byte counter label, e.g. "1.1 / 3.4 MB".</summary>
    private string VoterCurrentFileByteLabel()
    {
        var progress = VoterStore.CurrentFileName is { } fileName ? VoterStore.SyncProgress.GetValueOrDefault(fileName) : null;
        var totalBytes = progress?.TotalBytes ?? 0;
        var transferred = progress?.BytesTransferred ?? 0;
        return $"{transferred / 1024.0 / 1024.0:0.#} / {totalBytes / 1024.0 / 1024.0:0.#} MB";
    }

    /// <summary>
    /// The Local Voter Model current-file progress bar's fill percentage, 0-100. Unlike
    /// <see cref="CurrentFilePercent"/>, the "treat as complete" stage set has no Importing entry - this
    /// pipeline has no import step.
    /// </summary>
    private double VoterCurrentFilePercent()
    {
        var progress = VoterStore.CurrentFileName is { } fileName ? VoterStore.SyncProgress.GetValueOrDefault(fileName) : null;
        if (progress is not { TotalBytes: > 0 } || progress.BytesTransferred is not { } transferred)
        {
            return progress?.Stage is LlmRouterModelSyncStageInfo.Verifying or LlmRouterModelSyncStageInfo.Completed
                ? 100
                : 0;
        }

        return Math.Clamp(100.0 * transferred / progress.TotalBytes.Value, 0, 100);
    }

    /// <summary>The display label for one corpus file's current sync stage.</summary>
    private static string StageLabel(BenchmarkFileStatusInfo file, BenchmarkSyncProgressInfo? progress) => progress switch
    {
        { Stage: BenchmarkSyncStageInfo.Downloading } => "Downloading…",
        { Stage: BenchmarkSyncStageInfo.Verifying } => "Verifying…",
        { Stage: BenchmarkSyncStageInfo.Importing } => "Importing…",
        { Stage: BenchmarkSyncStageInfo.Completed } => "Synced",
        { Stage: BenchmarkSyncStageInfo.Failed } => "Failed",
        _ => file.Synced ? "Synced" : "Not synced",
    };

    /// <summary>The CSS color class for one corpus file's current sync stage.</summary>
    private static string StageClass(BenchmarkSyncProgressInfo? progress) => progress?.Stage switch
    {
        BenchmarkSyncStageInfo.Failed => "text-red-400",
        BenchmarkSyncStageInfo.Completed => "text-emerald-400",
        null => "text-slate-500",
        _ => "text-slate-400",
    };

    /// <summary>The display text for one corpus file's size/progress: rows imported, bytes downloaded so far, or the at-rest size and row count.</summary>
    private static string DescribeSize(BenchmarkFileStatusInfo file, BenchmarkSyncProgressInfo? progress)
    {
        if (progress is { RowsImported: { } rows })
        {
            return $"{rows:N0} rows";
        }

        if (progress is { BytesTransferred: { } bytes })
        {
            return $"{bytes / 1024.0 / 1024.0:0.#} MB downloaded";
        }

        return file.Synced ? $"{file.SizeBytes / 1024.0 / 1024.0:0.#} MB, {file.RowCount:N0} rows" : "Never synced";
    }

    /// <summary>The display text for one corpus file's last-synced time, or empty if it has never synced.</summary>
    private static string DescribeSyncedAt(BenchmarkFileStatusInfo file) =>
        file.SyncedAtUtc is { } syncedAt ? $"Synced {syncedAt.ToLocalTime():g} local" : string.Empty;

    /// <summary>
    /// Runs a mutation, surfacing a failure in the inline error banner rather than letting it escape into
    /// the renderer. Same wrapper shape as PriceSourcesAdmin's.
    /// </summary>
    private async Task<bool> RunAsync(Func<Task> operation)
    {
        _opError = null;
        try
        {
            await operation();
            return true;
        }
        catch (BenchmarkDataAdminException ex)
        {
            _opError = ex.Message;
            return false;
        }
    }

    /// <summary>
    /// The Local Voter Model header button's label: "Re-verify" once every file is cached (the button
    /// stays enabled in this state, unlike the corpus panel's <see cref="ActionLabel"/>/Store.Status.State
    /// pairing, since checksum verification is in-memory only and doesn't survive a process restart -
    /// re-running the sync is the only way to confirm already-cached files are still intact), "Update"
    /// when at least one file is missing, "Updating…" for the duration of a sync. Unlike
    /// <see cref="ActionLabel"/>, there is no "Check Failed" state - the base URL is a fixed pin, not a
    /// rolling ref, so there is nothing to recheck against.
    /// </summary>
    private string VoterActionLabel() =>
        VoterStore.IsSyncing ? "Updating…" : VoterStore.Status?.Current == true ? "Re-verify" : "Update";

    private Task RunVoterAction() => RunVoterAsync(() => VoterStore.SyncAsync());

    /// <summary>The display label for one voter file's current sync stage.</summary>
    private static string VoterStageLabel(LlmRouterModelFileStatusInfo file, LlmRouterModelSyncProgressInfo? progress) => progress switch
    {
        { Stage: LlmRouterModelSyncStageInfo.Downloading } => "Downloading…",
        { Stage: LlmRouterModelSyncStageInfo.Verifying } => "Verifying…",
        { Stage: LlmRouterModelSyncStageInfo.Failed } => "Failed",
        // A Completed event with no published size means an absent optional file was deliberately
        // skipped (the export inlines its weights), not that it synced. A cached-and-verified optional
        // file also reports Completed with BytesTransferred: null (it didn't need re-downloading), but
        // still carries its published TotalBytes - that case must fall through to "Synced" below.
        { Stage: LlmRouterModelSyncStageInfo.Completed, TotalBytes: null } when file.IsOptional => "Optional",
        // Otherwise Completed means this file finished this sync, even if the overall model status
        // (file.Synced) hasn't been refreshed yet - same as the at-rest (no progress) case below.
        { Stage: LlmRouterModelSyncStageInfo.Completed } => "Synced",
        _ => file.Synced ? "Synced" : (file.IsOptional ? "Optional" : "Not synced"),
    };

    /// <summary>The CSS color class for one voter file's current sync stage.</summary>
    private static string VoterStageClass(LlmRouterModelSyncProgressInfo? progress) => progress?.Stage switch
    {
        LlmRouterModelSyncStageInfo.Failed => "text-red-400",
        LlmRouterModelSyncStageInfo.Completed => "text-emerald-400",
        null => "text-slate-500",
        _ => "text-slate-400",
    };

    /// <summary>The display text for one voter file's size/progress: bytes downloaded so far, or the at-rest size.</summary>
    private static string VoterDescribeSize(LlmRouterModelFileStatusInfo file, LlmRouterModelSyncProgressInfo? progress)
    {
        if (progress is { BytesTransferred: { } bytes })
        {
            return $"{bytes / 1024.0 / 1024.0:0.#} MB downloaded";
        }

        if (file.Synced)
        {
            return $"{file.SizeBytes / 1024.0 / 1024.0:0.#} MB";
        }

        // Same "expected, permanent absence" distinction as VoterStageLabel - an optional file that was
        // never published shouldn't read as if a sync simply hasn't happened yet.
        return file.IsOptional ? "Optional - not published for this model" : "Never synced";
    }

    /// <summary>The display text for one voter file's last-synced time, or empty if it has never synced.</summary>
    private static string VoterDescribeSyncedAt(LlmRouterModelFileStatusInfo file) =>
        file.SyncedAtUtc is { } syncedAt ? $"Synced {syncedAt.ToLocalTime():g} local" : string.Empty;

    /// <summary>Same wrapper shape as <see cref="RunAsync"/>, for the Local Voter Model section's own store.</summary>
    private async Task<bool> RunVoterAsync(Func<Task> operation)
    {
        _voterOpError = null;
        try
        {
            await operation();
            return true;
        }
        catch (LlmRouterModelAdminException ex)
        {
            _voterOpError = ex.Message;
            return false;
        }
    }
}
