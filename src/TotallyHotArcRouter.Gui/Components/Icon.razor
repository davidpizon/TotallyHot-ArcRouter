@* Small inline stroke icons (24x24 grid, drawn from basic primitives) used across the dashboard. *@
<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     style="@Style">
    @switch (Name)
    {
        case "activity":
            <polyline points="2 12 7 12 10 4 14 20 17 12 22 12" />
            break;
        case "bar-chart":
            <line x1="6" y1="20" x2="6" y2="14" />
            <line x1="12" y1="20" x2="12" y2="4" />
            <line x1="18" y1="20" x2="18" y2="10" />
            break;
        case "trending-up":
            <polyline points="3 17 9 11 13 15 21 7" />
            <polyline points="15 7 21 7 21 13" />
            break;
        case "shield-check":
            <path d="M12 22C6.8 19.9 4 16.5 4 11V5l8-3 8 3v6c0 5.5-2.8 8.9-8 11z" />
            <polyline points="9 12 11.5 14.5 15.5 9.5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="21" y2="21" />
            break;
        case "alert-triangle":
            <path d="M12 3 2 20h20z" />
            <line x1="12" y1="10" x2="12" y2="14" />
            <line x1="12" y1="17" x2="12" y2="17.01" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" />
            <polyline points="8 12.5 11 15.5 16 9.5" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <polyline points="12 7 12 12 15.5 14" />
            break;
        case "copy":
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            break;
        case "x":
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
            break;
        case "trash":
            <polyline points="3 6 21 6" />
            <path d="M5 6l1 15h12l1-15" />
            <path d="M9 6V3h6v3" />
            <line x1="10" y1="10" x2="10" y2="17" />
            <line x1="14" y1="10" x2="14" y2="17" />
            break;
        case "rotate-ccw":
            <polyline points="2 4 2 10 8 10" />
            <path d="M3.5 14a9 9 0 1 0 2-9.5L2 8" />
            break;
        case "terminal":
            <polyline points="4 17 10 11 4 5" />
            <line x1="12" y1="19" x2="20" y2="19" />
            break;
        case "plus":
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
            break;
        case "key":
            <circle cx="7.5" cy="15.5" r="3.5" />
            <line x1="10" y1="13" x2="20" y2="3" />
            <line x1="16" y1="7" x2="19" y2="10" />
            break;
        case "server":
            <rect x="3" y="4" width="18" height="7" rx="1.5" />
            <rect x="3" y="13" width="18" height="7" rx="1.5" />
            <line x1="7" y1="7.5" x2="7.01" y2="7.5" />
            <line x1="7" y1="16.5" x2="7.01" y2="16.5" />
            break;
        case "database":
            <ellipse cx="12" cy="5" rx="8" ry="3" />
            <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
            <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
            break;
        case "grip-vertical":
            @* Two columns of dots: the conventional "drag me" handle glyph. Filled, since the shared
               svg is stroke-only (fill=none) and hollow rings read as noise at this size. *@
            <circle cx="9" cy="5" r="1" fill="currentColor" stroke="none" />
            <circle cx="9" cy="12" r="1" fill="currentColor" stroke="none" />
            <circle cx="9" cy="19" r="1" fill="currentColor" stroke="none" />
            <circle cx="15" cy="5" r="1" fill="currentColor" stroke="none" />
            <circle cx="15" cy="12" r="1" fill="currentColor" stroke="none" />
            <circle cx="15" cy="19" r="1" fill="currentColor" stroke="none" />
            break;
        case "chevron-up":
            <polyline points="6 15 12 9 18 15" />
            break;
        case "chevron-down":
            <polyline points="6 9 12 15 18 9" />
            break;
        case "play":
            <polygon points="8 5 19 12 8 19" />
            break;
        case "stop":
            <rect x="6" y="6" width="12" height="12" rx="1.5" />
            break;
        case "eject":
            @* Triangle over a bar - the standard eject mark. Drawn as an open path rather than a
               polygon so the bar below it stays a separate stroke at this size. *@
            <path d="M5 15h14L12 6z" />
            <line x1="5" y1="19" x2="19" y2="19" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3.5" />
            <line x1="12" y1="2" x2="12" y2="5" />
            <line x1="12" y1="19" x2="12" y2="22" />
            <line x1="2" y1="12" x2="5" y2="12" />
            <line x1="19" y1="12" x2="22" y2="12" />
            <line x1="4.9" y1="4.9" x2="7" y2="7" />
            <line x1="17" y1="17" x2="19.1" y2="19.1" />
            <line x1="19.1" y1="4.9" x2="17" y2="7" />
            <line x1="7" y1="17" x2="4.9" y2="19.1" />
            break;
    }
</svg>

@code {
    /// <summary>Which glyph to render; see the switch above for supported names.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Square size in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 13;

    /// <summary>Optional CSS classes forwarded to the svg element.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Optional inline style forwarded to the svg element (e.g. a stroke color via `color`).</summary>
    [Parameter]
    public string? Style { get; set; }
}
