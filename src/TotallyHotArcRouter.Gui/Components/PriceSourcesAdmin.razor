@* Governance > Price Sources pane: enable/disable each model price feed and pull fresh data on demand.
   Talks to the proxy's PriceSourceAdminService gRPC API via the injected PriceSourceStore.

   Shows feed metadata only - row counts and schedule, never prices. That's D5 (licensing), not a layout
   choice: see docs/router/model-price-catalog.md. *@
@implements IDisposable
@using System.Threading
@using Microsoft.JSInterop
@inject PriceSourceStore Store
@inject IJSRuntime Js

<div class="h-full overflow-y-auto pr-1">
    @if (!Store.IsLoaded)
    {
        <div class="text-sm text-slate-500 p-4">Loading price sources…</div>
    }
    else if (!Store.IsReachable)
    {
        <div class="rounded-lg p-4 space-y-2 ds-surface-card-critical">
            <div class="flex items-center gap-2 text-sm text-red-400 font-semibold">
                <Icon Name="alert-triangle" Size="20" /> Router unreachable
            </div>
            <div class="text-xs text-slate-400">
                Could not reach <span class="font-mono">@TelemetryChannelFactory.DefaultServerAddress</span>. Is the proxy running?
            </div>
            @if (!string.IsNullOrEmpty(Store.LastError))
            {
                <div class="text-xs text-slate-500 font-mono">@Store.LastError</div>
            }
            <button @onclick="Reload"
                    class="btn btn-ghost">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="flex items-center justify-between mb-3 gap-2">
            <span class="text-xs text-slate-500 uppercase tracking-widest">Price Data Sources</span>
            <div class="flex items-center gap-3 shrink-0">
                @* One clock, not one per row: a cycle refreshes every enabled source together. *@
                @if (Store.Schedule is not null)
                {
                    <span class="flex items-center gap-1.5 text-xs text-slate-500" title="@DescribeSchedule()">
                        <Icon Name="clock" Size="20" />
                        @DescribeCountdown()
                    </span>
                }
                <button @onclick="PullNow"
                        disabled="@Store.IsRefreshing"
                        class="btn btn-secondary flex items-center gap-1.5">
                    <Icon Name="refresh" Size="20" />
                    @(Store.IsRefreshing ? "Pulling…" : "Pull Now")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_opError))
        {
            <div class="mb-3 text-xs ds-alert-critical">
                @_opError
            </div>
        }

        @if (Store.Sources.Count == 0)
        {
            <div class="text-xs text-slate-500 p-4">No price sources are registered.</div>
        }

        @* No pointerup/pointerleave here: js/reorder-flip.js listens on document instead, so a drag
           survives the pointer leaving the list and still ends if it is released anywhere on screen. *@
        <div id="@FlipContainerId" class="ds-card-stack">
            @{ var sources = DisplayOrder; }
            @for (var i = 0; i < sources.Count; i++)
            {
                var index = i;
                var source = sources[index];
                var outcome = LastOutcomeFor(source.Name);
                var canReorder = sources.Count > 1;

                var canDrag = canReorder && !Store.IsRefreshing;
                var isLifted = _dragActive && _dragName == source.Name;
                var borderClass = isLifted ? "ds-source-border-lifted" : (source.Enabled ? "" : "ds-source-border-dim");

                @* Keep Razor comments outside the tag: written between attributes they are emitted as literal
                   markup rather than stripped, which reaches the browser as an invalid attribute name and takes
                   the whole render down.

                   Two nested elements per source, and the split is load-bearing:

                   The SLOT (.ds-card-slot) is the layout unit. It is always in flow and never transformed, so
                   it is the honest position of this row - which is why it, not the card, carries @key and
                   data-flip-key. The FLIP pass therefore always measures true layout even while the card inside
                   it is position: fixed, so a lifted card needs no special-casing there. It also means play()'s
                   inline transform lands on the slot rather than fighting the card's own scale.

                   The CARD is what gets picked up, and it follows the cursor. .card-pinned is what detaches it
                   (position: fixed, tracking the pointer on Y) and .card-lifted carries the shadow and accent
                   border.

                   BOTH are rendered here, and js/reorder-flip.js ALSO adds .card-pinned itself the instant the
                   press becomes a drag. That duplication is deliberate and load-bearing in both directions:
                   JS adds it first so the card detaches with no interop round-trip of latency, and Blazor
                   renders it so that the very next render - which DragStarted itself triggers, and which
                   rewrites this whole class attribute - does not wipe it back off. Losing it mid-drag does not
                   merely un-style the card: the inline top/left JS is writing are viewport coordinates, so a
                   card that falls back to position: relative gets flung hundreds of pixels out of the list.

                   Detaching is what makes any of this possible: the pane
                   around this stack is a scroll container, and a scroll container always clips at its padding
                   box, so an in-flow card can never follow a cursor past it no matter how much room its
                   containers are given - see DESIGN.md §5.4 for the five attempts that failed on exactly that,
                   and §5.5 for the rule.

                   Only pointerdown is handled here. Everything after it - tracking, deciding when the order
                   changes, and ending the drag - happens in JS and comes back through the [JSInvokable]
                   methods below, because routing pointermove through interop at 60-120Hz would visibly lag the
                   card behind the cursor. *@
                <div @key="source.Name" data-flip-key="@source.Name" class="ds-card-slot">
                <div class="rounded-lg p-3 space-y-2.5 @(canDrag ? "drag-enabled" : "drag-disabled") @(isLifted ? "card-lifted card-pinned" : "") ds-surface-card-draggable @borderClass"
                     @onpointerdown="e => OnPointerDown(source, e)">
                    @* Header: rank controls + name + toggle *@
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-start gap-2 min-w-0">
                            @if (canReorder)
                            {
                                <div class="flex items-center shrink-0" title="Drag to reorder. Priority: higher wins a contested price.">
                                    <Icon Name="grip-vertical" Size="14" Class="text-slate-600" />
                                </div>
                            }
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <Icon Name="database" Size="20" />
                                    <span class="text-sm font-semibold @(source.Enabled ? "state-enabled" : "state-disabled")">
                                        @source.Name
                                    </span>
                                    @if (canReorder)
                                    {
                                        <span class="text-xs font-mono text-slate-500">#@(index + 1)</span>
                                    }
                                </div>
                                <div class="text-xs text-slate-500 mt-0.5">
                                    @if (source.Enabled)
                                    {
                                        <span>Polled every cycle and served to routing.</span>
                                    }
                                    else
                                    {
                                        <span>Disabled — not polled, and its prices are not served.</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <button @onclick="() => Toggle(source)"
                                title="@(source.Enabled ? "Disable this source" : "Enable this source")"
                                class="shrink-0 flex items-center gap-1.5 rounded px-2 py-1 text-xs font-semibold border transition-colors @(source.Enabled ? "toggle-enabled" : "toggle-disabled")">
                            <span class="w-1.5 h-1.5 rounded-full @(source.Enabled ? "toggle-dot-enabled" : "toggle-dot-disabled")"></span>
                            @(source.Enabled ? "ENABLED" : "DISABLED")
                        </button>
                    </div>

                    @* Feed metadata: a count, never prices (D5). *@
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-slate-500">Prices stored</span>
                        <span class="font-mono text-xs text-slate-300">@source.PriceCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </div>

                    @if (outcome is not null)
                    {
                        <div class="rounded px-2 py-1.5 text-xs @(outcome.Succeeded ? "ds-outcome-success" : "ds-outcome-critical")">
                            @if (outcome.Succeeded)
                            {
                                <span class="text-emerald-400">✅ Last pull refreshed @outcome.PriceCount.ToString("N0", CultureInfo.InvariantCulture) prices.</span>
                            }
                            else
                            {
                                <span class="text-red-300">⚠️ Last pull failed: @outcome.Error</span>
                            }
                        </div>
                    }
                </div>
                </div>
            }
        </div>
    }
</div>

