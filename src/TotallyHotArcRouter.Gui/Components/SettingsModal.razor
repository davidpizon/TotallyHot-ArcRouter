@* System settings modal: telemetry connection settings, the adaptive-routing toggle and sample size
   (docs/router/self-organizing-classification-plan.md Phase T6), the shadow-judge toggle and backbone
   picker (docs/router/geval-shadow-scoring-plan.md), plus destructive actions gated behind a typed
   confirmation word. *@
@using TotallyHot.ArcRouter.Gui.Telemetry
@implements IDisposable
@inject LiveDataStore LiveDataStore
@inject IGuiSettingsStore SettingsStore
@inject RouterSettingsAdminStore RouterSettingsStore
@inject TotallyHot.ArcRouter.Gui.Services.UpdateStore UpdateStore
<div class="overlay-backdrop fixed inset-0 z-50 flex items-center justify-center"
     @onclick="OnClose">
    <div class="overlay-panel w-full max-w-md rounded-lg border border-slate-700"
         @onclick:stopPropagation="true">
        @* Header *@
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700">
            <span class="text-sm font-semibold text-slate-200 tracking-wide uppercase">System Settings</span>
            <button @onclick="OnClose"
                    aria-label="Close system settings"
                    class="text-slate-400 hover:text-slate-200 transition-colors">
                <Icon Name="x" Size="20" />
            </button>
        </div>

        <div class="overlay-content p-5 space-y-4">
            @* Connection settings *@
            <div class="space-y-2">
                <label for="telemetry-address" class="text-xs text-slate-400 font-medium uppercase tracking-widest">
                    Telemetry Server Address
                </label>
                <input id="telemetry-address"
                       type="text"
                       value="@_telemetryAddress"
                       @oninput="OnTelemetryAddressInput"
                       class="w-full px-3 py-2 text-sm font-mono ds-input" />
                @if (_telemetryAddressSaved)
                {
                    <p class="text-xs text-emerald-400">Saved. Restart the app to connect to the new address.</p>
                }
            </div>

            @* Adaptive routing (docs/router/self-organizing-classification-plan.md Phase T6) *@
            <div class="space-y-2">
                <label class="text-xs text-slate-400 font-medium uppercase tracking-widest">
                    Adaptive Routing
                </label>
                <div class="flex items-center gap-3">
                    <button @onclick="ToggleAdaptiveRouting"
                            aria-label="Toggle adaptive routing"
                            class="shrink-0 flex items-center gap-1.5 rounded px-2 py-1 text-xs font-semibold border transition-colors @(_adaptiveRoutingEnabled ? "toggle-enabled" : "toggle-disabled")">
                        <span class="w-1.5 h-1.5 rounded-full @(_adaptiveRoutingEnabled ? "toggle-dot-enabled" : "toggle-dot-disabled")"></span>
                        @(_adaptiveRoutingEnabled ? "On" : "Off")
                    </button>
                    <input id="sample-size"
                           type="number"
                           min="@MinEmbeddingMemoryCapacity"
                           max="@MaxEmbeddingMemoryCapacity"
                           step="1"
                           value="@_sampleSizeText"
                           @oninput="OnSampleSizeInput"
                           @onchange="OnSampleSizeChange"
                           class="w-28 px-3 py-2 text-sm font-mono ds-input" />
                    <span class="text-xs text-slate-500">Sample Size</span>
                    @if (ShowSampleSizeWarning)
                    {
                        <span class="ls-tip" tabindex="0" aria-describedby="ls-tooltip"
                              data-tip="a sample size of 20000 is recommended.">
                            <Icon Name="alert-triangle" Size="16" Class="text-amber-400" />
                        </span>
                    }
                </div>
            </div>

            @* Shadow judge (docs/router/geval-shadow-scoring-plan.md). The model list offers only free,
               enabled, OpenAI-compatible models from the Providers screen - the same list the server
               validates a save against. *@
            <div class="space-y-2">
                <label class="text-xs text-slate-400 font-medium uppercase tracking-widest">
                    Shadow Judge
                </label>
                <div class="flex items-center gap-3">
                    <button @onclick="ToggleJudgeEnabled"
                            aria-label="Toggle shadow judge"
                            class="shrink-0 flex items-center gap-1.5 rounded px-2 py-1 text-xs font-semibold border transition-colors @(_judgeEnabled ? "toggle-enabled" : "toggle-disabled")">
                        <span class="w-1.5 h-1.5 rounded-full @(_judgeEnabled ? "toggle-dot-enabled" : "toggle-dot-disabled")"></span>
                        @(_judgeEnabled ? "On" : "Off")
                    </button>
                    <select id="judge-model"
                            value="@_judgeModelName"
                            @onchange="OnJudgeModelChange"
                            disabled="@(_eligibleJudgeModels.Count == 0)"
                            class="flex-1 min-w-0 px-3 py-2 text-sm font-mono ds-input">
                        <option value="">Automatic</option>
                        @foreach (var model in _eligibleJudgeModels)
                        {
                            <option value="@model">@model</option>
                        }
                    </select>
                </div>
                @if (_eligibleJudgeModels.Count == 0)
                {
                    <p class="text-xs text-amber-400">
                        No free model is configured. Mark a provider as free in Providers to give the judge a backbone.
                    </p>
                }
                @if (_routerSettingsMessage is not null)
                {
                    <p class="text-xs @(_routerSettingsSaveFailed ? "text-red-400" : "text-emerald-400")">@_routerSettingsMessage</p>
                }
            </div>

            @* Software Update (docs/router/auto-update-plan.md Phase 2). Router self-update only - this
               GUI does not update itself, it only displays the Router's update status and triggers its
               apply. *@
            <div class="space-y-2">
                <label class="text-xs text-slate-400 font-medium uppercase tracking-widest">
                    Software Update
                </label>
                @if (UpdateStore.Status is { } status)
                {
                    <p class="text-xs text-slate-400">
                        Running <span class="font-mono text-slate-200">@status.CurrentVersion</span>
                        @if (status.UpdateAvailable)
                        {
                            <span class="text-amber-400"> — update available: <span class="font-mono">@status.LatestVersion</span></span>
                        }
                        else if (!string.IsNullOrEmpty(status.LatestVersion))
                        {
                            <span> — up to date</span>
                        }
                    </p>
                    @if (status.UnavailableReason != UpdateUnavailableReasonInfo.None)
                    {
                        <p class="text-xs text-slate-600">Last check: @status.UnavailableDetail</p>
                    }
                }
                else if (UpdateStore.IsLoaded && !UpdateStore.IsReachable)
                {
                    <p class="text-xs text-amber-400">Could not reach the router. Is the proxy running?</p>
                }
                <div class="flex gap-2">
                    <button @onclick="CheckForUpdatesNow" disabled="@UpdateStore.IsBusy" class="flex-1 btn btn-ghost">
                        @(UpdateStore.IsBusy ? "Checking…" : "Check Now")
                    </button>
                    @if (UpdateStore.Status?.UpdateAvailable == true)
                    {
                        <button @onclick="StartApplyConfirmation" disabled="@UpdateStore.IsBusy" class="flex-1 btn btn-ghost-warning">
                            Apply Update
                        </button>
                    }
                </div>
                @if (_confirmingApply)
                {
                    <div class="space-y-2 ds-destructive-box-warning">
                        <p class="text-xs text-slate-400 leading-5">
                            This will download and install the update, which requires administrator approval
                            and will restart the application. Continue?
                        </p>
                        <div class="flex gap-2">
                            <button @onclick="@(() => _confirmingApply = false)" class="flex-1 btn btn-ghost">
                                Cancel
                            </button>
                            <button @onclick="ApplyUpdateConfirmed" disabled="@UpdateStore.IsBusy" class="flex-1 btn btn-critical">
                                Confirm Apply
                            </button>
                        </div>
                    </div>
                }
                @if (UpdateStore.LastApplyOutcome is { } applyOutcome)
                {
                    <p class="text-xs @(applyOutcome.Succeeded ? "text-emerald-400" : "text-red-400")">@applyOutcome.Message</p>
                }
                @if (_updateErrorMessage is not null)
                {
                    <p class="text-xs text-red-400">@_updateErrorMessage</p>
                }
            </div>

            @* Unified save *@
            <button @onclick="SaveAll" disabled="@_saving" class="btn btn-ghost w-full">
                @(_saving ? "Saving…" : "Save")
            </button>

            @* Destructive zone label *@
            <div class="flex items-center gap-2 text-xs text-amber-400 font-medium uppercase tracking-widest">
                <Icon Name="alert-triangle" Size="20" />
                <span>Destructive Actions Zone</span>
            </div>

            @if (_activeAction is null)
            {
                <div class="grid grid-cols-2 gap-3">
                    <button @onclick="@(() => StartAction("reset"))"
                            class="btn btn-ghost-warning flex items-center justify-center gap-2">
                        <Icon Name="refresh" Size="20" />
                        Reset Stats
                    </button>
                    <button @onclick="@(() => StartAction("purge"))"
                            class="btn btn-ghost-critical flex items-center justify-center gap-2">
                        <Icon Name="trash" Size="20" />
                        Clear History
                    </button>
                </div>
            }
            else
            {
                @* Confirmation step: the action only enables once the confirmation word is typed exactly. *@
                <div class="space-y-3 @(_activeAction == "reset" ? "ds-destructive-box-warning" : "ds-destructive-box-critical")">
                    <p class="text-xs text-slate-400 leading-5">
                        This action is <span class="text-red-400 font-semibold">irreversible</span>. Type
                        <span class="font-mono text-slate-200 bg-slate-700 px-1.5 py-0.5 rounded text-xs">@Required</span>
                        to confirm.
                    </p>
                    <input @ref="_confirmInput"
                           type="text"
                           value="@_confirmText"
                           @oninput="e => _confirmText = ((string?)e.Value ?? string.Empty).ToUpperInvariant()"
                           placeholder="Type @(Required)..."
                           class="w-full px-3 py-2 text-sm font-mono ds-input" />
                    <div class="flex gap-2">
                        <button @onclick="CancelAction"
                                class="flex-1 btn btn-ghost">
                            Cancel
                        </button>
                        <button @onclick="ExecuteAction"
                                disabled="@(!IsConfirmed)"
                                class="flex-1 btn btn-critical">
                            Confirm @(_activeAction == "reset" ? "Reset" : "Purge")
                        </button>
                    </div>
                </div>
            }

            <p class="text-xs text-slate-600 pt-1">
                All system configurations, routing rules, and budget caps are preserved.
            </p>
        </div>
    </div>
</div>

@code {
    /// <summary>Invoked when the modal should close - clicking the backdrop, the X button, or confirming a destructive action.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>The inclusive lower bound accepted for Sample Size, mirroring <c>RouterSettingsAdminGrpcService.MinEmbeddingMemoryCapacity</c>.</summary>
    private const int MinEmbeddingMemoryCapacity = 500;

    /// <summary>The inclusive upper bound accepted for Sample Size, mirroring <c>RouterSettingsAdminGrpcService.MaxEmbeddingMemoryCapacity</c>.</summary>
    private const int MaxEmbeddingMemoryCapacity = 50_000;

    /// <summary>The Sample Size below which the warning icon/tooltip renders, matching <c>RoutingOptions</c>'s shipped default.</summary>
    private const int RecommendedEmbeddingMemoryCapacity = 20_000;

    private string? _activeAction;
    private string _confirmText = string.Empty;
    private ElementReference _confirmInput;
    private bool _focusPending;
    private string _telemetryAddress = string.Empty;
    private bool _telemetryAddressSaved;
    private bool _adaptiveRoutingEnabled;
    private int _embeddingMemoryCapacity = RecommendedEmbeddingMemoryCapacity;
    private string _sampleSizeText = RecommendedEmbeddingMemoryCapacity.ToString();
    private bool _judgeEnabled;
    private string _judgeModelName = string.Empty;
    private IReadOnlyList<string> _eligibleJudgeModels = [];
    private bool _saving;
    private string? _routerSettingsMessage;
    private bool _routerSettingsSaveFailed;
    private bool _confirmingApply;
    private string? _updateErrorMessage;

    /// <summary>The exact word the operator must type to confirm the active destructive action.</summary>
    private string Required => _activeAction == "reset" ? "RESET" : "PURGE";

    /// <summary>Whether the typed confirmation text exactly matches <see cref="Required"/>.</summary>
    private bool IsConfirmed => _confirmText == Required;

    // Read off the live (possibly out-of-bounds or unparsable) text rather than the clamped
    // _embeddingMemoryCapacity, which only updates on blur/save - otherwise the warning would lag a full
    // keystroke behind what the operator actually typed.
    /// <summary>Whether the warning icon/tooltip should render for the Sample Size text as currently typed.</summary>
    private bool ShowSampleSizeWarning => int.TryParse(_sampleSizeText, out var parsed) && parsed < RecommendedEmbeddingMemoryCapacity;

    protected override async Task OnInitializedAsync()
    {
        _telemetryAddress = SettingsStore.Load().TelemetryServerAddress;

        UpdateStore.Changed += OnUpdateStoreChanged;
        await UpdateStore.LoadAsync();

        await RouterSettingsStore.LoadAsync();
        if (RouterSettingsStore.Settings is { } settings)
        {
            _adaptiveRoutingEnabled = settings.AdaptiveRoutingEnabled;
            _embeddingMemoryCapacity = settings.EmbeddingMemoryCapacity;
            _sampleSizeText = settings.EmbeddingMemoryCapacity.ToString();
            _judgeEnabled = settings.JudgeEnabled;
            _eligibleJudgeModels = settings.EligibleJudgeModels;

            // A stored pick that is no longer eligible is shown as Automatic rather than as a phantom
            // option: that is what the selector will actually do at call time, and re-offering the dead
            // name would let the operator "save" a choice the server would now reject.
            _judgeModelName = _eligibleJudgeModels.Contains(settings.JudgeModelName, StringComparer.OrdinalIgnoreCase)
                ? settings.JudgeModelName
                : string.Empty;
        }
    }

    /// <summary>Updates the address field and clears any stale "Saved" confirmation from a previous save.</summary>
    private void OnTelemetryAddressInput(ChangeEventArgs e)
    {
        _telemetryAddress = (string?)e.Value ?? string.Empty;
        _telemetryAddressSaved = false;
    }

    /// <summary>Flips the adaptive-routing toggle and clears any stale save outcome from a previous attempt.</summary>
    private void ToggleAdaptiveRouting()
    {
        _adaptiveRoutingEnabled = !_adaptiveRoutingEnabled;
        ClearRouterSettingsMessage();
    }

    /// <summary>Flips the shadow-judge toggle and clears any stale save outcome from a previous attempt.</summary>
    private void ToggleJudgeEnabled()
    {
        _judgeEnabled = !_judgeEnabled;
        ClearRouterSettingsMessage();
    }

    /// <summary>Tracks the judge-model selection; an empty value is the explicit "Automatic" choice.</summary>
    private void OnJudgeModelChange(ChangeEventArgs e)
    {
        _judgeModelName = (string?)e.Value ?? string.Empty;
        ClearRouterSettingsMessage();
    }

    // Only tracks the raw text here - deliberately does NOT parse into _embeddingMemoryCapacity on every
    // keystroke. The input's value is bound to _sampleSizeText (not the int), so an in-progress edit that
    // doesn't currently parse (e.g. the field cleared to type a new number) is preserved verbatim instead of
    // being clobbered by a stale re-render of the last-known-good integer.
    /// <summary>Tracks the Sample Size input's raw text as the operator types, and clears any stale save outcome.</summary>
    private void OnSampleSizeInput(ChangeEventArgs e)
    {
        _sampleSizeText = (string?)e.Value ?? string.Empty;
        ClearRouterSettingsMessage();
    }

    /// <summary>Parses and clamps the Sample Size once the operator leaves the field.</summary>
    private void OnSampleSizeChange(ChangeEventArgs e)
    {
        _sampleSizeText = (string?)e.Value ?? string.Empty;
        ClampSampleSize();
    }

    /// <summary>
    /// Parses <see cref="_sampleSizeText"/> into <see cref="_embeddingMemoryCapacity"/> (keeping the prior
    /// value on a parse failure), clamps into <see cref="MinEmbeddingMemoryCapacity"/>/
    /// <see cref="MaxEmbeddingMemoryCapacity"/> - defense in depth ahead of the server-side clamp
    /// <c>RouterSettingsAdminGrpcService.UpdateRouterSettings</c> actually enforces - and resyncs the
    /// display text to the clamped canonical value.
    /// </summary>
    private void ClampSampleSize()
    {
        if (int.TryParse(_sampleSizeText, out var parsed))
        {
            _embeddingMemoryCapacity = parsed;
        }

        _embeddingMemoryCapacity = Math.Clamp(_embeddingMemoryCapacity, MinEmbeddingMemoryCapacity, MaxEmbeddingMemoryCapacity);
        _sampleSizeText = _embeddingMemoryCapacity.ToString();
    }

    /// <summary>Clears the router settings' save outcome message, e.g. because the operator edited a field after a prior save attempt.</summary>
    private void ClearRouterSettingsMessage()
    {
        _routerSettingsMessage = null;
        _routerSettingsSaveFailed = false;
    }

    // Runs both persistence paths from the one footer button. Outcomes are reported per-concern rather than
    // blended: the telemetry address keeps its own "Saved" note, and the router settings report "Applied" or
    // the router-unreachable/rejection state independently, mirroring PriceSourcesAdmin's own gRPC error
    // rendering (docs/router/self-organizing-classification-plan.md Phase T6).
    /// <summary>Persists the telemetry address (if changed) and the adaptive-routing settings in one action.</summary>
    private async Task SaveAll()
    {
        _saving = true;
        try
        {
            SaveTelemetryAddress();
            await SaveRouterSettings();
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Trims and persists the typed telemetry address, then shows the "Saved" confirmation.</summary>
    private void SaveTelemetryAddress()
    {
        var trimmed = _telemetryAddress.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        _telemetryAddress = trimmed;
        SettingsStore.Save(SettingsStore.Load() with { TelemetryServerAddress = trimmed });
        _telemetryAddressSaved = true;
    }

    // Reads the outcome off RouterSettingsAdminStore's own IsReachable/LastError rather than recomputing a
    // message from the caught exception - the store already resolved unreachable-vs-rejected via
    // IRouterSettingsAdminClient's isUnavailable flag, so recomputing it here would just duplicate that logic.
    /// <summary>Clamps the Sample Size, then persists the adaptive-routing and shadow-judge settings through <see cref="RouterSettingsAdminStore"/>.</summary>
    private async Task SaveRouterSettings()
    {
        ClampSampleSize();

        try
        {
            await RouterSettingsStore.UpdateAsync(
                _adaptiveRoutingEnabled,
                _embeddingMemoryCapacity,
                _judgeEnabled,
                _judgeModelName);
            _routerSettingsMessage = "Applied";
            _routerSettingsSaveFailed = false;

            // The eligible list is recomputed server-side on every response, so a provider toggled in another
            // window since this modal opened is reflected here without a reopen.
            if (RouterSettingsStore.Settings is { } saved)
            {
                _eligibleJudgeModels = saved.EligibleJudgeModels;
            }
        }
        catch (RouterSettingsAdminException)
        {
            _routerSettingsMessage = RouterSettingsStore.IsReachable
                ? RouterSettingsStore.LastError
                : "Could not reach the router. Is the proxy running?";
            _routerSettingsSaveFailed = true;
        }
    }

    /// <summary>Opens the type-to-confirm step for the given destructive action and queues focus on its input.</summary>
    private void StartAction(string action)
    {
        _activeAction = action;
        _confirmText = string.Empty;
        _focusPending = true;
    }

    /// <summary>Closes the type-to-confirm step without executing the action.</summary>
    private void CancelAction()
    {
        _activeAction = null;
        _confirmText = string.Empty;
    }

    // Both actions clear this session's live view (LiveDataStore.ClearEvents); Clear History additionally
    // empties the Console tab's log buffer, since "history" reads as everything accumulated, not just the
    // Live Stream/Cost Analytics stats "Reset Stats" implies. Neither touches the proxy's own durable
    // history (see ClearEvents' remarks) or any persisted configuration - the note below the buttons stays
    // accurate.
    /// <summary>Runs the confirmed destructive action (Reset Stats or Clear History), then closes the modal.</summary>
    private async Task ExecuteAction()
    {
        if (!IsConfirmed)
        {
            return;
        }

        LiveDataStore.ClearEvents();
        if (_activeAction == "purge")
        {
            LiveDataStore.ClearLogLines();
        }

        CancelAction();
        await OnClose.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending)
        {
            _focusPending = false;
            await _confirmInput.FocusAsync();
        }
    }

    /// <summary>Re-renders when <see cref="UpdateStore"/> publishes a state change (a load, check, or apply completing).</summary>
    private void OnUpdateStoreChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Forces an immediate update check via the "Check Now" button.</summary>
    private async Task CheckForUpdatesNow()
    {
        _updateErrorMessage = null;
        try
        {
            await UpdateStore.CheckNowAsync();
        }
        catch (UpdateAdminException)
        {
            // UpdateStore already recorded IsReachable/LastError; the panel reads those via
            // UpdateStore.Status remaining unchanged on failure, so nothing further to do here.
        }
    }

    /// <summary>Opens the "this restarts the Router service" confirmation ahead of applying.</summary>
    private void StartApplyConfirmation()
    {
        _confirmingApply = true;
        _updateErrorMessage = null;
    }

    /// <summary>Applies the update once the operator has confirmed the install/restart.</summary>
    private async Task ApplyUpdateConfirmed()
    {
        _confirmingApply = false;
        try
        {
            await UpdateStore.ApplyAsync();
        }
        catch (InvalidOperationException ex)
        {
            // No update was known available - e.g. a background CheckNowAsync/LoadAsync raced this
            // confirmation and cleared the status between the button appearing and the click landing.
            _updateErrorMessage = ex.Message;
        }
    }

    /// <inheritdoc />
    public void Dispose() => UpdateStore.Changed -= OnUpdateStoreChanged;
}
