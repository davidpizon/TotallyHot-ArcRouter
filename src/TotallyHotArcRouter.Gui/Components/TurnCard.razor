@* One turn (multi-step agent workflow) in the Live Stream turn list. Compact two-line card:
   header (request excerpt as title + agent chip) and a single wrapping stat strip, so many turns
   fit on screen. The card background and left border are tinted with the selected agent's color
   (same visual language as the routing-decision rows in the drill-down). Clicking the header
   expands the routing decision log and the request/response text. Metric tooltips are floating
   data-tip tooltips (wwwroot/js/tooltips.js). *@
<div class="rounded ls-turn-card"
     style="background:@(AgentColor)10;border-left:3px solid @AgentColor">
    @* Header: turn number · request excerpt · agent chip · timestamp · expand toggle. The sub-spans
       here are informational only (no tabindex/aria-describedby of their own): nesting a focusable
       element inside a <button> is an ARIA anti-pattern, so screen-reader users instead get the
       same facts via this button's aria-label; sighted keyboard users already see the plain text. *@
    <button @onclick="() => _expanded = !_expanded"
            aria-label="@HeaderAriaLabel"
            class="w-full flex items-center gap-2 px-2.5 pt-1.5 text-left ls-turn-card-toggle">
        <span class="text-xs font-mono text-slate-500 shrink-0 ls-tip"
              data-tip="Turn position within this conversation">@Turn.TurnNumber/@TotalTurns</span>
        <span class="text-xs font-medium text-slate-200 ls-truncate ls-flex-auto">@TitleExcerpt</span>
        <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold ls-tip"
              data-tip="Agent the router selected for this turn"
              style="background:@(AgentColor)22;color:@AgentColor;border:1px solid @(AgentColor)44">@Turn.Agent</span>
        @if (Turn.IsFallback)
        {
            <span class="ds-badge-warning shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold ls-tip"
                  data-tip="This turn was served by fallback routing">⚠</span>
        }
        <span class="text-xs font-mono text-slate-600 shrink-0">@Turn.Timestamp</span>
        <span class="text-xs text-slate-500 shrink-0" aria-hidden="true">@(_expanded ? "▴" : "▾")</span>
    </button>

    @* Stat strip, ranked by business priority (ROI → cost → tokens → steps → cache → TTFT → context).
       Each stat is its own tab stop (tabindex="0") with aria-describedby pointing at the shared
       floating tooltip (wwwroot/js/tooltips.js), so every metric a mouse user can hover is also
       reachable and announced for keyboard/screen-reader users. *@
    <div class="flex flex-wrap items-baseline px-2.5 pb-1.5 pt-1 ls-stat-strip-gap">
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Routing ROI: cost reduction from routing this task to a cheaper model vs. the worst-case expensive model">
            <span class="ls-stat-label">ROI</span>
            <span class="font-mono text-xs @(Turn.RoutingRoi > 0 ? "metric-positive" : "metric-neutral")">
                @(Turn.RoutingRoi > 0 ? $"{Turn.RoutingRoi.ToString("F1", CultureInfo.InvariantCulture)}% ↓" : "—")
            </span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="@CostTip">
            <span class="ls-stat-label">Cost</span>
            <span class="font-mono text-xs metric-accent">$@Turn.TotalCost.ToString("F6", CultureInfo.InvariantCulture)</span>
            @if (IsApproximateCost)
            {
                <span aria-hidden="true" class="metric-fallback">≈</span>
            }
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Token volume: prompt tokens sent to the LLM / completion tokens generated. Watch prompt tokens compound turn-over-turn (the hockey stick curve).">
            <span class="ls-stat-label">Tok P/C</span>
            <span class="font-mono text-xs stat-color-tokens">@Turn.PromptTokens.ToString("N0", CultureInfo.InvariantCulture)<span class="text-slate-600">/</span>@Turn.CompletionTokens.ToString("N0", CultureInfo.InvariantCulture)</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Tool execution steps: number of tool invocations/API calls within this turn's multi-step workflow">
            <span class="ls-stat-label">Steps</span>
            <span class="font-mono text-xs metric-fallback">@Turn.ToolExecutionSteps</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Cache hit rate: percentage of prompt tokens served from the provider's prompt cache instead of being processed from scratch">
            <span class="ls-stat-label">Cache</span>
            <span class="font-mono text-xs @(Turn.CacheHitRate > 0 ? "metric-positive" : "metric-neutral")">
                @(Turn.CacheHitRate > 0 ? $"{Turn.CacheHitRate.ToString("F0", CultureInfo.InvariantCulture)}%" : "—")
            </span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Time to first token: time elapsed from the routing decision to the first token received from the LLM">
            <span class="ls-stat-label">TTFT</span>
            <span class="font-mono text-xs stat-color-ttft">@Turn.TimeToFirstTokenMs ms</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Context buffer: current session context size relative to the model's maximum context window">
            <span class="ls-stat-label">Ctx</span>
            <span class="font-mono text-xs text-slate-300">@Turn.ContextBufferPercent.ToString("F1", CultureInfo.InvariantCulture)%</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Model the router selected for this turn">
            <span class="ls-stat-label">Model</span>
            <span class="font-mono text-xs @(Turn.IsFallback || IsSubstituted ? "metric-fallback" : "metric-accent")">@Turn.Model</span>
        </span>
    </div>

    @if (_expanded)
    {
        <div class="px-2.5 pb-2.5 space-y-2 pt-1.5 expanded-section-border">
            @* Routing decision log, color-coded by step status *@
            <div class="space-y-1.5">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Routing Decision</div>
                @{ var stepIndex = 0; }
                @foreach (var step in Turn.RoutingSteps)
                {
                    // Steps stagger in sequence: unlike a plain list, their order is the causal
                    // chain of the routing decision, so the reveal order is the meaning
                    // (docs/gui/MOTION.md §7).
                    var i = stepIndex++;
                    @switch (step.Status)
                    {
                        case StepStatus.Warn:
                            <div class="disclosure-enter flex items-start gap-2 rounded px-2 py-1.5 text-xs font-mono ds-step-warning"
                                 style="--i:@i">
                                <Icon Name="alert-triangle" Size="16" Class="mt-0.5 shrink-0" />
                                <span>@step.Message</span>
                            </div>
                            break;
                        case StepStatus.Info:
                            <div class="disclosure-enter flex items-start gap-2 rounded px-2 py-1.5 text-xs font-mono ds-step-info"
                                 style="--i:@i">
                                <span class="mt-0.5">➔</span>
                                <span>@step.Message</span>
                            </div>
                            break;
                        default:
                            <div class="disclosure-enter flex items-start gap-2 rounded px-2 py-1.5 text-xs font-mono ds-step-success"
                                 style="--i:@i">
                                <Icon Name="check-circle" Size="16" Class="mt-0.5 shrink-0" />
                                <span>@step.Message</span>
                            </div>
                            break;
                    }
                }
            </div>

            @* Request / response text *@
            @if (Turn.RequestSummary is not null)
            {
                <div>
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Request</div>
                    <pre class="ls-payload rounded p-2 text-xs font-mono ds-code-block">@Turn.RequestSummary</pre>
                </div>
            }
            @if (Turn.ResponseSummary is not null)
            {
                <div>
                    <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Response</div>
                    <pre class="ls-payload rounded p-2 text-xs font-mono ds-code-block">@Turn.ResponseSummary</pre>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>The turn this card renders.</summary>
    [Parameter, EditorRequired]
    public ConversationTurn Turn { get; set; } = null!;

    /// <summary>Total number of turns in the parent conversation, used in the "N/total" header label.</summary>
    [Parameter, EditorRequired]
    public int TotalTurns { get; set; }

    private bool _expanded;

    /// <summary>The card's accent color, derived from the turn's agent name.</summary>
    private string AgentColor => ColorUtils.GetColorForAgent(Turn.Agent);

    // §5.6: distinguishes an exact cost from a disclosed estimate (a resolution-ladder rung below Exact,
    // or a cache dimension that fell back to the standard input rate) without needing a chip per turn.
    /// <summary>Whether the turn's cost is a disclosed approximation rather than an exact figure.</summary>
    private bool IsApproximateCost => Turn.CostConfidence is "CatalogApproximate";

    /// <summary>The Cost stat's tooltip text, explaining why the figure is unknown/approximate when it isn't an exact cost.</summary>
    private string CostTip => Turn.CostConfidence switch
    {
        "NoUsage" => "Total turn cost: usage could not be extracted for this turn, so cost is unknown (shown as $0).",
        "Unknown" => "Total turn cost: no fresh catalog price for this model, so cost is unknown (shown as $0).",
        "CatalogApproximate" => "Total turn cost: an approximate estimate - a cache rate or model match fell back to a conservative default. See docs/router/token-tracking-improvements.md §5.6/§5.7.",
        _ => "Total turn cost: prompt token cost + completion token cost for this turn",
    };

    // Substitution reasons that describe the client's own choice rather than an override - mirrors
    // LiveConversationMapper.SilentSubstitutionReasons so the header stays silent on exactly the turns
    // whose routing-decision log also stays silent.
    private static readonly HashSet<string> SilentSubstitutionReasons = new(StringComparer.Ordinal)
    {
        "None",
        "AutoSelect",
    };

    /// <summary>Whether the router substituted a model the client did not ask for (docs/router/orchestrator-live-path-plan.md §M3.1) - drives the Model stat's fallback styling and the header's accessible label.</summary>
    private bool IsSubstituted =>
        Turn.SubstitutionReason is { } reason && !SilentSubstitutionReasons.Contains(reason)
        && Turn.RequestedModel is not null && Turn.RoutedModel is not null;

    // Screen-reader equivalent of the header's visible sub-spans (see the accessibility note in the
    // markup above for why those spans aren't independently focusable).
    /// <summary>The header button's accessible label, restating the turn's identifying facts and current expand/collapse state.</summary>
    private string HeaderAriaLabel =>
        $"Turn {Turn.TurnNumber} of {TotalTurns}, agent {Turn.Agent}" +
        (Turn.IsFallback ? ", fallback routing" : string.Empty) +
        (IsSubstituted ? $", requested {Turn.RequestedModel}, routed to {Turn.RoutedModel}" : string.Empty) +
        $", at {Turn.Timestamp}. {(_expanded ? "Collapse" : "Expand")} details.";

    // First few words of the turn's request text, used as the card title.
    /// <summary>The card header's title text: the first 8 words of the request summary, or a generic "Turn N" label when there is none.</summary>
    private string TitleExcerpt
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Turn.RequestSummary))
            {
                return $"Turn {Turn.TurnNumber}";
            }

            var words = Turn.RequestSummary.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return words.Length <= 8 ? Turn.RequestSummary : string.Join(' ', words.Take(8)) + "…";
        }
    }
}
