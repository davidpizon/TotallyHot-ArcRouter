<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 (not net10.0-windows), mirroring TotallyHotArcRouter.Gui.Telemetry/.Admin: the tray's
         status/balloon formatting, routing-gate polling, and discovery-file reading are all OS-agnostic
         logic, so they build and unit-test on any platform even though the only project that ever
         references this one (TotallyHotArcRouter.Tray, net10.0-windows WinForms) is Windows-only
         (web GUI migration plan Phase P8). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TotallyHot.ArcRouter.Tray</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gui.Telemetry already carries everything the tray talks to the router through: RoutingGateAdminClient/
         IRoutingGateAdminClient, NativeRouterChannelProvider, TelemetryChannelFactory (cert trust + the
         loopback session cookie - see RoutingGateMonitor's remarks for why the tray reuses this rather
         than pulling Gui.Components). Reused, not rebuilt, per the plan's own "Reuse (do not rebuild)"
         list. -->
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Telemetry\TotallyHotArcRouter.Gui.Telemetry.csproj" />
  </ItemGroup>

</Project>
