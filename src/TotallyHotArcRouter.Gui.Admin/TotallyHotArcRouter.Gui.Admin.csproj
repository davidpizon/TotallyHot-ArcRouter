<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 (not net10.0-windows / MAUI), mirroring TotallyHotArcRouter.Gui.Charts/.Telemetry:
         the DTOs and the gRPC client logic for the proxy's provider/usage admin surface live here so
         they build and unit-test on any platform. TotallyHot.ArcRouter.Gui.Services.ProviderAdminStore
         is the thin glue that wraps the client in this library. Compiles its own copy of admin.proto
         (GrpcServices="Client"); that file has its own csharp_namespace so this does not collide with
         Gui.Telemetry's telemetry.proto. This project now references Gui.Telemetry so
         ProviderAdminClient / UsageQueryClient can derive from GrpcAdminClientBase (ADR-0010 Amendment 3). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TotallyHot.ArcRouter.Gui.Admin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TotallyHotArcRouter.Gui.Telemetry\TotallyHotArcRouter.Gui.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\admin.proto" Link="Protos\admin.proto" GrpcServices="Client" ProtoRoot="..\Protos" />
  </ItemGroup>

</Project>

