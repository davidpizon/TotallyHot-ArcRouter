<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 library: DTOs and aggregation logic shared with the WASM dashboard, so it
         builds and unit-tests on any platform. Deliberately does not reference the TotallyHotArcRouter
         proxy project - it's an independent DTO/wire-contract layer for a separately deployable
         process, not a compiled-type dependency on the proxy itself. It DOES compile
         Protos/telemetry.proto (GrpcServices="Client") so Grpc.Tools runs in a normal SDK-style
         build (see the Protobuf ItemGroup below); Gui.Components.Services.LiveDataStore consumes
         the generated Contract types through this project's compiled output. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TotallyHot.ArcRouter.Gui.Telemetry</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiles Protos/telemetry.proto here (GrpcServices="Client") rather than in a host project:
         Grpc.Tools needs a normal SDK-style build, and this library is already the DTO/wire-contract
         layer LiveDataStore consumes. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\telemetry.proto" Link="Protos\telemetry.proto" GrpcServices="Client" ProtoRoot="..\Protos" />
  </ItemGroup>

</Project>

