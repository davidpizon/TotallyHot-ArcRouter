<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TotallyHot.ArcRouter</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Matches TotallyHotArcRouter.Gui.Admin/.Charts/.Console/.Telemetry: CS1591 (missing XML doc on a
         public member) becomes a build error via TreatWarningsAsErrors above, so undocumented public
         API can't creep back in. The generated gRPC server stub (Telemetry.cs/TelemetryGrpc.cs) already
         self-suppresses CS1591 via its own `#pragma warning disable 1591`, so this doesn't fight codegen. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes internal helpers (e.g. ProviderCredentialResolver) to the unit-test project. -->
    <InternalsVisibleTo Include="TotallyHotArcRouter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grpc.AspNetCore already transitively brings in Grpc.Tools (it's a meta-package for exactly
         this: server + client + codegen), but it's referenced explicitly here too so the codegen
         dependency isn't implicit - matches TotallyHotArcRouter.Gui.csproj's explicit Grpc.Tools reference. -->
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- First database dependency in the repo: the model price catalog's SQLite store
         (docs/router/model-price-catalog.md). Nothing used a database before - router memory is a
         plain JSON file. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Local, in-process BGE-large embedding inference for PLAN.md Phase J's task-embedding-keyed
         memory - no network hop inline with routing, no dependency on an operator having configured
         an embeddings-capable provider. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!-- WordPiece tokenizer matching BGE's BERT-family vocabulary; used by OnnxEmbeddingClient to
         turn task text into the token ids OnnxRuntime's InferenceSession expects. -->
    <PackageReference Include="FastBertTokenizer" Version="1.0.28" />
    <!-- Autoregressive generation (KV-cache, greedy sampling, tokenization) for the llm_router voter's
         local ONNX-hosted small instruct model (PLAN.md Phase L) - owns exactly the generation-loop
         complexity the plain Microsoft.ML.OnnxRuntime session above would otherwise require hand-rolling. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.2" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Pin the native SQLite bundle above the version Microsoft.Data.Sqlite pulls transitively:
         SQLitePCLRaw.lib.e_sqlite3 <= 2.1.10 carries GHSA-2m69-gcr7-jv3q, patched in 2.1.11+. This
         direct reference wins over the transitive 2.1.10 and clears the NuGet audit (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.79.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server-side codegen (service base class + message types) for the telemetry gRPC contract -
         see docs/router/grpc-migration.md. Shared verbatim with TotallyHotArcRouter.Gui's GrpcServices="Client"
         codegen of the same file, so the two sides can never structurally drift. -->
    <!-- Link: see the matching comment on TotallyHotArcRouter.Gui.csproj's copy of this item - keeps this
         out-of-project-tree file correctly recognized by MSBuild/Visual Studio and its codegen step. -->
    <Protobuf Include="..\Protos\telemetry.proto" Link="Protos\telemetry.proto" GrpcServices="Server" ProtoRoot="..\Protos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TotallyHotArcRouter.Sandbox\TotallyHotArcRouter.Sandbox.csproj" />
  </ItemGroup>

</Project>

